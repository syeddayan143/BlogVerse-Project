@model BlogVerse.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>

    .admin-page {
        padding: 25px;
    }

    .admin-header {
        margin-bottom: 30px;
    }

        .admin-header h1 {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .admin-header p {
            color: #777;
            margin: 0;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 35px rgba(0,0,0,0.12);
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #F4EAF1;
        font-size: 22px;
        margin-bottom: 18px;
    }

    .stat-card h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
    }

    .stat-card p {
        margin-top: 5px;
        color: #777;
        margin-bottom: 0;
    }

    .admin-actions {
        background: white;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.07);
    }

        .admin-actions h3 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .admin-actions p {
            color: #777;
        }

    .management-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 20px;
        background: #222;
        color: white;
        border-radius: 10px;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease;
    }

        .management-btn:hover {
            background: #000;
            color: white;
            transform: translateY(-2px);
        }


    @@media (max-width: 1100px) {

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 600px) {

        .admin-page {
            padding: 15px;
        }

        .admin-header h1 {
            font-size: 26px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .admin-actions {
            padding: 20px;
        }
    }

</style>


<div class="admin-page">

    <!-- HEADER -->

    <div class="admin-header">

        <h1>
            Admin Dashboard
        </h1>

        <p>
            Manage BlogVerse users and monitor the platform.
        </p>

    </div>


    <!-- STATISTICS -->

    <div class="stats-grid">


        <!-- TOTAL USERS -->

        <div class="stat-card">

            <div class="stat-icon">
                👥
            </div>

            <h2>
                @Model.TotalUsers
            </h2>

            <p>
                Total Users
            </p>

        </div>


        <!-- ACTIVE USERS -->

        <div class="stat-card">

            <div class="stat-icon">
                ✓
            </div>

            <h2>
                @Model.ActiveUsers
            </h2>

            <p>
                Active Users
            </p>

        </div>


        <!-- DEACTIVATED -->

        <div class="stat-card">

            <div class="stat-icon">
                !
            </div>

            <h2>
                @Model.DeactivatedUsers
            </h2>

            <p>
                Deactivated Users
            </p>

        </div>


        <!-- POSTS -->

        <div class="stat-card">

            <div class="stat-icon">
                📝
            </div>

            <h2>
                @Model.TotalPosts
            </h2>

            <p>
                Total Posts
            </p>

        </div>

    </div>


    <!-- MANAGEMENT -->

    <div class="admin-actions">

        <h3>
            User Management
        </h3>

        <p>
            View registered users and control their
            account activation status.
        </p>

        <a href="@Url.Action("Index", "Users")"
           class="management-btn">

            <span>👥</span>

            Manage Users

        </a>

    </div>

</div>