@model BlogVerse.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    /* =========================================================
           ADMIN LIQUID GLASS DASHBOARD
           ========================================================= */

    .admin-page {
        min-height: 100vh;
        padding: 30px;
        color: #1f2937;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .admin-header {
        position: relative;
        overflow: hidden;
        padding: 32px;
        margin-bottom: 25px;
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.48);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.75);
        box-shadow: 0 20px 50px rgba(31, 41, 55, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        animation: adminFadeUp 0.6s ease;
    }

        .admin-header::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            top: -130px;
            right: -70px;
            background: rgba(255, 255, 255, 0.45);
            border-radius: 50%;
            filter: blur(5px);
        }

    .admin-header-content {
        position: relative;
        z-index: 2;
    }

    .admin-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 13px;
        margin-bottom: 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.55);
        border: 1px solid rgba(255, 255, 255, 0.8);
        font-size: 12px;
        font-weight: 700;
        color: #4b5563;
    }

    .admin-header h1 {
        margin: 0 0 7px;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -0.7px;
        color: #111827;
    }

    .admin-header p {
        margin: 0;
        color: #6b7280;
        font-size: 15px;
        line-height: 1.6;
    }

    /* =========================================================
           STATISTICS
           ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        padding: 24px;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        border: 1px solid rgba(255, 255, 255, 0.75);
        box-shadow: 0 15px 40px rgba(31, 41, 55, 0.07), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: adminFadeUp 0.6s ease both;
    }

        .stat-card:nth-child(1) {
            animation-delay: 0.05s;
        }

        .stat-card:nth-child(2) {
            animation-delay: 0.1s;
        }

        .stat-card:nth-child(3) {
            animation-delay: 0.15s;
        }

        .stat-card:nth-child(4) {
            animation-delay: 0.2s;
        }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            right: -60px;
            bottom: -65px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.35);
            pointer-events: none;
        }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 50px rgba(31, 41, 55, 0.11), inset 0 1px 0 rgba(255, 255, 255, 0.9);
        }

    .stat-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        border-radius: 17px;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 8px 20px rgba(31, 41, 55, 0.07), inset 0 1px 0 rgba(255, 255, 255, 0.9);
        font-size: 21px;
        color: #374151;
    }

    .stat-card h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        color: #111827;
    }

    .stat-card p {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
    }

    /* =========================================================
           MANAGEMENT CARD
           ========================================================= */

    .admin-actions {
        position: relative;
        overflow: hidden;
        padding: 30px;
        border-radius: 26px;
        background: rgba(255, 255, 255, 0.46);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.78);
        box-shadow: 0 18px 45px rgba(31, 41, 55, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.85);
        animation: adminFadeUp 0.7s ease;
    }

        .admin-actions::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            top: -100px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.4);
        }

    .admin-actions-content {
        position: relative;
        z-index: 2;
    }

    .management-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 17px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.58);
        border: 1px solid rgba(255, 255, 255, 0.8);
        font-size: 22px;
        box-shadow: 0 8px 20px rgba(31, 41, 55, 0.07);
    }

    .admin-actions h3 {
        margin: 0 0 7px;
        font-size: 22px;
        font-weight: 800;
        color: #111827;
    }

    .admin-actions p {
        margin: 0 0 20px;
        max-width: 650px;
        color: #6b7280;
        line-height: 1.6;
        font-size: 14px;
    }

    /* =========================================================
           MANAGEMENT BUTTON
           ========================================================= */

    .management-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 19px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.68);
        border: 1px solid rgba(255, 255, 255, 0.9);
        color: #1f2937;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(31, 41, 55, 0.07), inset 0 1px 0 rgba(255, 255, 255, 0.9);
        transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }

        .management-btn:hover {
            color: #111827;
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-3px);
            box-shadow: 0 13px 28px rgba(31, 41, 55, 0.11);
        }

    /* =========================================================
           ANIMATION
           ========================================================= */

    @@keyframes adminFadeUp {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 1100px) {

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 700px) {

        .admin-page {
            padding: 18px;
        }

        .admin-header {
            padding: 24px;
            border-radius: 22px;
        }

            .admin-header h1 {
                font-size: 27px;
            }

        .stats-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .stat-card {
            padding: 21px;
            border-radius: 21px;
        }

        .admin-actions {
            padding: 24px;
            border-radius: 22px;
        }

        .management-btn {
            width: 100%;
        }
    }

    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 400px) {

        .admin-page {
            padding: 13px;
        }

        .admin-header {
            padding: 20px;
        }

            .admin-header h1 {
                font-size: 24px;
            }

            .admin-header p {
                font-size: 13px;
            }
    }
</style>


<div class="admin-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="admin-header">

        <div class="admin-header-content">

            <div class="admin-badge">
                🛡️ BlogVerse Administration
            </div>

            <h1>
                Admin Dashboard
            </h1>

            <p>
                Manage BlogVerse users and monitor the platform
                from one simple dashboard.
            </p>

        </div>

    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="stats-grid">

        <!-- TOTAL USERS -->

        <div class="stat-card">

            <div class="stat-icon">
                👥
            </div>

            <h2>
                @Model.TotalUsers
            </h2>

            <p>
                Total Users
            </p>

        </div>


        <!-- ACTIVE USERS -->

        <div class="stat-card">

            <div class="stat-icon">
                ✓
            </div>

            <h2>
                @Model.ActiveUsers
            </h2>

            <p>
                Active Users
            </p>

        </div>


        <!-- DEACTIVATED USERS -->

        <div class="stat-card">

            <div class="stat-icon">
                !
            </div>

            <h2>
                @Model.DeactivatedUsers
            </h2>

            <p>
                Deactivated Users
            </p>

        </div>


        <!-- TOTAL POSTS -->

        <div class="stat-card">

            <div class="stat-icon">
                📝
            </div>

            <h2>
                @Model.TotalPosts
            </h2>

            <p>
                Total Posts
            </p>

        </div>

    </div>


    <!-- =====================================================
         USER MANAGEMENT
    ====================================================== -->

    <div class="admin-actions">

        <div class="admin-actions-content">

            <div class="management-icon">
                👤
            </div>

            <h3>
                User Management
            </h3>

            <p>
                View all registered users and control their
                account activation status.
            </p>

            <a href="@Url.Action("Index", "Users")"
               class="management-btn">

                <span>👥</span>

                Manage Users

                <span>→</span>

            </a>

        </div>

    </div>

</div>