@* Views/Dashboard/Settings.cshtml *@

@{
    ViewData["Title"] = "Settings";

    string profileImage =
        ViewBag.ProfileImagePath as string
        ?? "/images/default-profile.png";

    var prefs = ViewBag.UserPreferences as BlogVerse.Models.UserDashboardPreference;
    var currentTheme = prefs?.ThemeColor ?? "#0f172a";
    var currentAccent = prefs?.AccentColor ?? "#38bdf8";
    var currentFont = prefs?.FontFamily ?? "Segoe UI";
    var currentStyle = prefs?.DashboardStyle ?? "glassmorphism";
}

<style>
    :root {
        --primary-bg: #F4EAF1;
        --navbar-bg: #B9B1CD;
        --footer-bg: #B6A8CA;
        --text-color: #000000;
        --link-color: #007bff;
    }

    .card-header {
        background-color: var(--navbar-bg) !important;
        color: var(--text-color) !important;
        border-bottom: 1px solid #ddd;
    }

    .card-body {
        background-color: var(--primary-bg) !important;
        color: var(--text-color) !important;
    }

    h2, h5, label, .form-check-label {
        color: var(--text-color) !important;
    }

    .profile-section {
        display: flex;
        align-items: center;
        gap: 25px;
        padding: 20px;
        background: rgba(255,255,255,0.55);
        border-radius: 15px;
        margin-bottom: 25px;
    }

    .profile-image-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .profile-image {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .profile-info h4 {
        margin-bottom: 5px;
        font-weight: 700;
    }

    .profile-info p {
        margin-bottom: 12px;
        color: #666;
    }

    .profile-upload {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

        .profile-upload input[type="file"] {
            max-width: 100%;
        }

    .btn-primary {
        background-color: var(--link-color) !important;
        border-color: var(--link-color) !important;
        color: white !important;
    }

    .btn-secondary {
        background-color: #6c757d !important;
        border-color: #6c757d !important;
        color: white !important;
    }

    .btn-danger {
        color: white !important;
    }

    .alert {
        border-radius: 10px;
    }

    @@media (max-width: 576px) {
        .profile-section {
            flex-direction: column;
            text-align: center;
        }

        .profile-upload {
            justify-content: center;
        }

            .profile-upload input[type="file"] {
                width: 100%;
            }
    }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h2 class="mb-0">Account Settings</h2>
                </div>

                <div class="card-body">

                    @* SUCCESS MESSAGE *@
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    @* ERROR MESSAGE *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <!-- ======================================
                         PROFILE PHOTO
                    ======================================= -->
                    <h5 class="mb-3">Profile Photo</h5>
                    <div class="profile-section">
                        <div class="profile-image-wrapper">
                            <img src="@profileImage" alt="Profile Photo" class="profile-image" />
                        </div>
                        <div class="profile-info">
                            <h4>@ViewBag.UserName</h4>
                            <p>@ViewBag.UserEmail</p>

                            <!-- UPLOAD PHOTO -->
                            <form asp-controller="Dashboard"
                                  asp-action="UploadProfilePhoto"
                                  method="post"
                                  enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <div class="profile-upload">
                                    <input type="file"
                                           name="ProfilePhoto"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.gif,.webp"
                                           required />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-camera me-2"></i> Upload Photo
                                    </button>
                                </div>
                            </form>

                            <!-- REMOVE PHOTO -->
                            @if (!string.IsNullOrWhiteSpace(ViewBag.ProfileImagePath))
                            {
                                <form asp-controller="Dashboard"
                                      asp-action="RemoveProfilePhoto"
                                      method="post"
                                      class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash me-2"></i> Remove Photo
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- ======================================
                         [NEW] DASHBOARD CUSTOMIZATION & 10 MORPHISM STYLES
                    ======================================= -->
                    <h5 class="mb-3">🎨 Dashboard Customization & 10 Morphism Styles</h5>
                    <p class="text-muted small mb-3">Customize your dashboard look and feel. Your preferences are saved to your profile.</p>

                    <form asp-action="SaveCustomizationSettings" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Base Background Color</label>
                                <input type="color" name="themeColor" value="@currentTheme" class="form-control form-control-color w-100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Accent / Highlight Color</label>
                                <input type="color" name="accentColor" value="@currentAccent" class="form-control form-control-color w-100" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">✨ Dashboard Design System (Morphism Styles)</label>
                            <select name="dashboardStyle" class="form-select">
                                <option value="glassmorphism" selected="@(currentStyle == "glassmorphism")">1. Glassmorphism (Frosted Glass & Blur)</option>
                                <option value="neumorphism" selected="@(currentStyle == "neumorphism")">2. Neumorphism (Soft Extruded Shadows)</option>
                                <option value="claymorphism" selected="@(currentStyle == "claymorphism")">3. Claymorphism (Soft 3D Rounded Bulky Cards)</option>
                                <option value="auroramorphism" selected="@(currentStyle == "auroramorphism")">4. Auroramorphism (Northern Lights Glowing Gradients)</option>
                                <option value="skeuomorphism" selected="@(currentStyle == "skeuomorphism")">5. Skeuomorphism (Realistic Tactile Textures & Gloss)</option>
                                <option value="skeuominimalism" selected="@(currentStyle == "skeuominimalism")">6. Skeuominimalism (Clean Minimal with Subtle Realism)</option>
                                <option value="genmorphism" selected="@(currentStyle == "genmorphism")">7. Genmorphism (Vibrant Gen-Z Neo-Brutalism)</option>
                                <option value="woodmorphism" selected="@(currentStyle == "woodmorphism")">8. Woodmorphism (Warm Timber & Carved Wood Tone)</option>
                                <option value="metalmorphism" selected="@(currentStyle == "metalmorphism")">9. Metalmorphism (Brushed Steel & Chrome Metallic)</option>
                                <option value="papermorphism" selected="@(currentStyle == "papermorphism")">10. Papermorphism (Stacked Layered Cardstock Paper)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Dashboard Font Family</label>
                            <select name="fontFamily" class="form-select">
                                <option value="Segoe UI" selected="@(currentFont == "Segoe UI")">Segoe UI (Default)</option>
                                <option value="Inter, sans-serif" selected="@(currentFont.Contains("Inter"))">Inter (Modern Sans)</option>
                                <option value="Georgia, serif" selected="@(currentFont.Contains("Georgia"))">Georgia (Classic Serif)</option>
                                <option value="Courier New, monospace" selected="@(currentFont.Contains("Courier"))">Courier New (Monospace)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Add Custom Widget Title</label>
                            <div class="input-group">
                                <input type="text" name="customWidgetName" class="form-control" placeholder="e.g. My Notes, Quick Tasks..." />
                                <button type="submit" class="btn btn-dark fw-bold">Add Widget</button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold mt-2 py-2">💾 Save Dashboard Customization</button>
                    </form>

                    <hr class="my-4">

                    <!-- ======================================
                         PROFILE SETTINGS (Original)
                    ======================================= -->
                    <h5 class="mb-3">Profile Settings</h5>
                    <div class="mb-3">
                        <label for="displayName" class="form-label">Display Name</label>
                        <input type="text" class="form-control" id="displayName" value="@ViewBag.UserName">
                    </div>
                    <div class="mb-3">
                        <label for="bio" class="form-label">Bio</label>
                        <textarea class="form-control" id="bio" rows="3">A short description about yourself.</textarea>
                    </div>

                    <hr class="my-4">

                    <!-- ======================================
                         EMAIL NOTIFICATIONS
                    ======================================= -->
                    <h5 class="mb-3">Email Notifications</h5>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="newFollower" checked>
                        <label class="form-check-label" for="newFollower">Notify me when someone follows me</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="newComment">
                        <label class="form-check-label" for="newComment">Notify me of new comments on my blogs</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="blogUpdates" checked>
                        <label class="form-check-label" for="blogUpdates">Receive updates about new blogs from followed channels</label>
                    </div>

                    <hr class="my-4">

                    <!-- ======================================
                         PRIVACY SETTINGS
                    ======================================= -->
                    <h5 class="mb-3">Privacy Settings</h5>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="profileVisibility" id="public" value="public" checked>
                        <label class="form-check-label" for="public">Public - Everyone can view my profile</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="profileVisibility" id="private" value="private">
                        <label class="form-check-label" for="private">Private - Only followers can view my profile</label>
                    </div>

                    <button class="btn btn-primary">
                        <i class="fas fa-save me-2"></i> Save Changes
                    </button>
                    <button class="btn btn-secondary ms-2">
                        <i class="fas fa-undo me-2"></i> Reset Settings
                    </button>

                </div>
            </div>

        </div>
    </div>
</div>