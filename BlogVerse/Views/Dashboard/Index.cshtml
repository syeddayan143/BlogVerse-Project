@model BlogVerse.ViewModels.DashboardViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<style>
    .blog-dashboard {
        padding: 24px;
    }

    /* =========================
           HERO
        ========================= */

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #111827, #1f2937);
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 28px;
        color: #ffffff;
    }

        .dashboard-hero::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            right: -80px;
            top: -100px;
        }

        .dashboard-hero::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            right: 120px;
            bottom: -100px;
        }

    .dashboard-hero-content {
        position: relative;
        z-index: 2;
        max-width: 700px;
    }

    .dashboard-hero h1 {
        margin: 0 0 10px;
        font-size: 34px;
        line-height: 1.2;
        font-weight: 800;
    }

    .dashboard-hero p {
        margin: 0;
        color: #d1d5db;
        font-size: 15px;
        line-height: 1.7;
    }

    /* =========================
           SEARCH
        ========================= */

    .dashboard-search {
        margin-top: 24px;
        max-width: 650px;
    }

    .dashboard-search-box {
        display: flex;
        align-items: center;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 14px;
        overflow: hidden;
    }

        .dashboard-search-box span {
            padding-left: 15px;
            font-size: 18px;
        }

        .dashboard-search-box input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            color: #ffffff;
            padding: 13px 14px;
            font-size: 14px;
        }

            .dashboard-search-box input::placeholder {
                color: #cbd5e1;
            }

    /* =========================
           TABS
        ========================= */

    .dashboard-tabs {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        margin-bottom: 22px;
        padding-bottom: 4px;
    }

    .dashboard-tab {
        border: none;
        background: #f3f4f6;
        color: #4b5563;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: 0.2s ease;
    }

        .dashboard-tab:hover {
            background: #e5e7eb;
        }

        .dashboard-tab.active {
            background: #111827;
            color: #ffffff;
        }

    /* =========================
           CATEGORY FILTERS
        ========================= */

    .category-section {
        margin-bottom: 25px;
    }

    .category-title {
        font-size: 15px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 12px;
    }

    .category-pills {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .category-pill {
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #4b5563;
        padding: 8px 14px;
        border-radius: 999px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .category-pill:hover,
        .category-pill.active {
            background: #111827;
            color: #ffffff;
            border-color: #111827;
        }

    /* =========================
           SECTION HEADER
        ========================= */

    .posts-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

        .posts-section-header h2 {
            margin: 0;
            font-size: 25px;
            font-weight: 800;
            color: #111827;
        }

    .posts-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 13px;
        border-radius: 999px;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* =========================
           NEWS GRID
        ========================= */

    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    /* =========================
           NEWS CARD
        ========================= */

    .news-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 7px 25px rgba(0,0,0,0.05);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .news-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 35px rgba(0,0,0,0.10);
        }

    /* =========================
           IMAGE
        ========================= */

    .news-image {
        width: 100%;
        height: 205px;
        background: #f3f4f6;
        overflow: hidden;
    }

        .news-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .news-card:hover .news-image img {
        transform: scale(1.05);
    }

    .news-image.no-image {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 135deg, #eef2ff, #f5f3ff );
    }

        .news-image.no-image span {
            font-size: 48px;
        }

    /* =========================
           CARD CONTENT
        ========================= */

    .news-card-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 20px;
    }

    .news-category {
        display: inline-flex;
        align-self: flex-start;
        background: #eef2ff;
        color: #4f46e5;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        margin-bottom: 11px;
    }

    .news-card-content h3 {
        margin: 0 0 9px;
        color: #111827;
        font-size: 20px;
        line-height: 1.35;
        font-weight: 800;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .news-author {
        color: #6b7280;
        font-size: 12px;
        line-height: 1.5;
        margin-bottom: 12px;
    }

    .news-description {
        color: #4b5563;
        font-size: 14px;
        line-height: 1.7;
        margin: 0 0 20px;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* =========================
           CARD FOOTER
        ========================= */

    .news-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid #f1f5f9;
    }

    .news-stats {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        color: #6b7280;
        font-size: 11px;
    }

        .news-stats span {
            white-space: nowrap;
        }

    .read-more-btn {
        color: #4f46e5;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

        .read-more-btn:hover {
            color: #3730a3;
            text-decoration: underline;
        }

    /* =========================
           ATTACHMENT BADGE
        ========================= */

    .attachment-badge {
        color: #7c3aed;
        font-weight: 700;
    }

    /* =========================
           EMPTY POSTS
        ========================= */

    .no-posts {
        grid-column: 1 / -1;
        background: #ffffff;
        border: 1px dashed #d1d5db;
        border-radius: 20px;
        padding: 60px 25px;
        text-align: center;
    }

    .no-posts-icon {
        font-size: 52px;
        margin-bottom: 12px;
    }

    .no-posts h3 {
        margin: 0 0 8px;
        font-size: 22px;
        color: #111827;
        font-weight: 800;
    }

    .no-posts p {
        margin: 0 0 20px;
        color: #6b7280;
        font-size: 14px;
    }

    .create-post-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #111827;
        color: #ffffff;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
    }

        .create-post-btn:hover {
            background: #1f2937;
            color: #ffffff;
        }

    /* =========================
           NO SEARCH RESULT
        ========================= */

    .no-search-result {
        display: none;
        grid-column: 1 / -1;
        text-align: center;
        padding: 45px 20px;
        color: #6b7280;
    }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 1100px) {
        .news-grid

    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    }

    @@media (max-width: 768px) {
        .blog-dashboard

    {
        padding: 18px;
    }

    .dashboard-hero {
        padding: 25px;
        border-radius: 20px;
    }

        .dashboard-hero h1 {
            font-size: 27px;
        }

    .news-grid {
        grid-template-columns: 1fr;
    }

    .posts-section-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .news-image {
        height: 220px;
    }

    }

    @@media (max-width: 480px) {
        .blog-dashboard

    {
        padding: 14px;
    }

    .dashboard-hero {
        padding: 22px;
    }

        .dashboard-hero h1 {
            font-size: 24px;
        }

    .news-card-content {
        padding: 17px;
    }

    .news-card-footer {
        align-items: flex-start;
        flex-direction: column;
    }

    }</style>


<div class="blog-dashboard">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="dashboard-hero">

        <div class="dashboard-hero-content">

            <h1>
                Welcome to BlogVerse 👋
            </h1>

            <p>
                Discover stories, ideas and experiences
                shared by the BlogVerse community.
            </p>


            <!-- SEARCH -->

            <div class="dashboard-search">

                <div class="dashboard-search-box">

                    <span>🔍</span>

                    <input type="text"
                           id="postSearch"
                           placeholder="Search posts, categories or authors..."
                           autocomplete="off" />

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         TABS
    ====================================================== -->

    <div class="dashboard-tabs">

        <button type="button"
                class="dashboard-tab active"
                data-tab="all">
            All Posts
        </button>

        <button type="button"
                class="dashboard-tab"
                data-tab="latest">
            Latest
        </button>

        <button type="button"
                class="dashboard-tab"
                data-tab="popular">
            Popular
        </button>

        <button type="button"
                class="dashboard-tab"
                data-tab="trending">
            Trending
        </button>

    </div>


    <!-- =====================================================
         CATEGORY FILTERS
    ====================================================== -->
    @{
        var categories = Model.Posts
        .Where(p => !string.IsNullOrWhiteSpace(p.Category))
        .Select(p => p.Category!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c)
        .ToList();
    }

    @if (categories.Any())
    {
        <div class="category-section">

            <div class="category-title">
                Browse by Category
            </div>

            <div class="category-pills">

                <button type="button"
                        class="category-pill active"
                        data-category="all">
                    All
                </button>

                @foreach (var category in categories)
                {
                    <button type="button"
                            class="category-pill"
                            data-category="@category">
                        @category
                    </button>
                }

            </div>

        </div>
    }


    <!-- =====================================================
         POSTS HEADER
    ====================================================== -->

    <div class="posts-section-header">

        <h2>
            Latest Posts
        </h2>

        <span class="posts-count">
            @Model.Posts.Count
            @(Model.Posts.Count == 1 ? "Post" : "Posts")
        </span>

    </div>


    <!-- =====================================================
         POSTS GRID
    ====================================================== -->

    <div class="news-grid"
         id="postsGrid">

        @if (Model.Posts != null &&
                Model.Posts.Any())
        {
            @foreach (var post in Model.Posts)
            {
                var authorName =
                post.User != null &&
                !string.IsNullOrWhiteSpace(
                post.User.Name)
                ? post.User.Name
                : "BlogVerse User";

                var postDate =
                post.PublishedAt ??
                post.CreatedAt;

                var plainText =
                System.Text.RegularExpressions
                .Regex
                .Replace(
                post.Content ?? "",
                "<.*?>",
                string.Empty
                );

                plainText =
                System.Net.WebUtility
                .HtmlDecode(plainText)
                .Trim();

                if (plainText.Length > 180)
                {
                    plainText =
                    plainText.Substring(0, 180)
                    + "...";
                }

                <article class="news-card"
                         data-category="@post.Category"
                         data-title="@post.Title"
                         data-author="@authorName"
                         data-date="@postDate.Ticks"
                         data-views="@post.Views"
                         data-likes="@post.Likes">

                    <!-- IMAGE -->
                    @if (!string.IsNullOrWhiteSpace(
                                post.ImagePath))
                    {
                        <div class="news-image">

                            <img src="@post.ImagePath"
                                 alt="@post.Title"
                                 loading="lazy"
                                 draggable="false" />

                        </div>
                    }
                    else
                    {
                        <div class="news-image no-image">

                            <span>📝</span>

                        </div>
                    }


                <!-- CONTENT -->

                <div class="news-card-content">

                    <!-- CATEGORY -->

                    <span class="news-category">
                        @(string.IsNullOrWhiteSpace(
                                            post.Category)
                                            ? "General"
                                            : post.Category)
                </span>


                        <!-- TITLE -->

                        <h3>
                            @post.Title
                        </h3>


                        <!-- AUTHOR / DATE -->

                        <div class="news-author">

                            👤 @authorName

                            <span> · </span>

                            📅 @postDate.ToString("MMM dd, yyyy")

                        </div>


                        <!-- DESCRIPTION -->

                        <p class="news-description">
                            @plainText
                        </p>


                        <!-- FOOTER -->

                        <div class="news-card-footer">

                            <div class="news-stats">

                                <span>
                                    👁 @post.Views
                                </span>

                                <span>
                                    ❤️ @post.Likes
                                </span>

                        @if (!string.IsNullOrWhiteSpace(
                                                post.AttachmentPath))
                                {
                                    <span class="attachment-badge">
                                        📎
                                    </span>
                                }

                            </div>


                            <a asp-controller="Posts"
                               asp-action="Details"
                               asp-route-id="@post.Id"
                               class="read-more-btn">

                                Read More →

                            </a>

                        </div>

                    </div>

                </article>
            }


            <!-- SEARCH EMPTY -->

            <div class="no-search-result"
                 id="noSearchResult">

                🔍

                <h3>
                    No matching posts found
                </h3>

                <p>
                    Try another title, category or author.
                </p>

            </div>
        }
        else
        {
            <!-- =================================================
                 NO POSTS
            ================================================== -->

            <div class="no-posts">

                <div class="no-posts-icon">
                    📝
                </div>

                <h3>
                    No Published Posts Yet
                </h3>

                <p>
                    Be the first person to share
                    something with the BlogVerse community.
                </p>

                <a asp-controller="Posts"
                   asp-action="Create"
                   class="create-post-btn">

                    ✍️ Create Your First Post

                </a>

            </div>
        }

    </div>

</div>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const searchInput =
                document.getElementById(
                    "postSearch"
                );

            const postCards =
                Array.from(
                    document.querySelectorAll(
                        ".news-card"
                    )
                );

            const noSearchResult =
                document.getElementById(
                    "noSearchResult"
                );

            const tabButtons =
                document.querySelectorAll(
                    ".dashboard-tab"
                );

            const categoryButtons =
                document.querySelectorAll(
                    ".category-pill"
                );


            let selectedCategory = "all";

            let selectedTab = "all";


            /* =========================================
               FILTER POSTS
            ========================================== */

            function filterPosts() {

                const searchTerm =
                    searchInput
                        ? searchInput.value
                            .toLowerCase()
                            .trim()
                        : "";


                let visibleCount = 0;


                postCards.forEach(function (card) {

                    const title =
                        (
                            card.dataset.title || ""
                        ).toLowerCase();

                    const author =
                        (
                            card.dataset.author || ""
                        ).toLowerCase();

                    const category =
                        (
                            card.dataset.category || ""
                        ).toLowerCase();

                    const searchMatch =
                        !searchTerm ||
                        title.includes(searchTerm) ||
                        author.includes(searchTerm) ||
                        category.includes(searchTerm);


                    const categoryMatch =
                        selectedCategory === "all" ||
                        category ===
                            selectedCategory.toLowerCase();


                    let tabMatch = true;


                    /*
                        Latest:
                        Controller already sends newest
                        posts first, so all posts remain.

                        Popular:
                        Posts with higher views/likes
                        are shown first.

                        Trending:
                        Posts with recent/high activity
                        are shown first.
                    */

                    if (selectedTab === "popular") {

                        tabMatch = true;

                    }

                    if (selectedTab === "trending") {

                        tabMatch = true;

                    }


                    const visible =
                        searchMatch &&
                        categoryMatch &&
                        tabMatch;


                    card.style.display =
                        visible ? "" : "flex";


                    if (visible) {
                        visibleCount++;
                    }

                });


                if (noSearchResult) {

                    noSearchResult.style.display =
                        visibleCount === 0
                            ? "block"
                            : "none";

                }


                if (
                    selectedTab === "popular" ||
                    selectedTab === "trending"
                ) {

                    sortPosts();

                }

            }


            /* =========================================
               SORT POSTS
            ========================================== */

            function sortPosts() {

                const grid =
                    document.getElementById(
                        "postsGrid"
                    );

                if (!grid) {
                    return;
                }


                const cards =
                    Array.from(
                        grid.querySelectorAll(
                            ".news-card"
                        )
                    );


                if (selectedTab === "popular") {

                    cards.sort(function (a, b) {

                        const aScore =
                            Number(
                                a.dataset.views || 0
                            ) +
                            Number(
                                a.dataset.likes || 0
                            ) * 3;

                        const bScore =
                            Number(
                                b.dataset.views || 0
                            ) +
                            Number(
                                b.dataset.likes || 0
                            ) * 3;

                        return bScore - aScore;

                    });

                }
                else if (selectedTab === "trending") {

                    cards.sort(function (a, b) {

                        const aDate =
                            Number(
                                a.dataset.date || 0
                            );

                        const bDate =
                            Number(
                                b.dataset.date || 0
                            );

                        return bDate - aDate;

                    });

                }
                else {

                    cards.sort(function (a, b) {

                        const aDate =
                            Number(
                                a.dataset.date || 0
                            );

                        const bDate =
                            Number(
                                b.dataset.date || 0
                            );

                        return bDate - aDate;

                    });

                }


                cards.forEach(function (card) {

                    grid.appendChild(card);

                });


                if (noSearchResult) {

                    grid.appendChild(
                        noSearchResult
                    );

                }

            }


            /* =========================================
               SEARCH
            ========================================== */

            if (searchInput) {

                searchInput.addEventListener(
                    "input",
                    filterPosts
                );

            }


            /* =========================================
               TABS
            ========================================== */

            tabButtons.forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        tabButtons.forEach(
                            function (item) {
                                item.classList.remove(
                                    "active"
                                );
                            }
                        );

                        button.classList.add(
                            "active"
                        );

                        selectedTab =
                            button.dataset.tab ||
                            "all";

                        sortPosts();

                        filterPosts();

                    }
                );

            });


            /* =========================================
               CATEGORY
            ========================================== */

            categoryButtons.forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            categoryButtons.forEach(
                                function (item) {
                                    item.classList.remove(
                                        "active"
                                    );
                                }
                            );

                            button.classList.add(
                                "active"
                            );

                            selectedCategory =
                                button.dataset.category ||
                                "all";

                            filterPosts();

                        }
                    );

                }
            );


            /* =========================================
               INITIAL SORT
            ========================================== */

            sortPosts();

        }
    );

</script>