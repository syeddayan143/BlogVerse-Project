@model BlogVerse.ViewModels.DashboardViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    // Read stored user preferences from DB for dynamic custom styling
    var dashboardPrefs = ViewBag.UserPreferences as BlogVerse.Models.UserDashboardPreference;
    var dynTheme = dashboardPrefs?.ThemeColor ?? "#0f172a";
    var dynAccent = dashboardPrefs?.AccentColor ?? "#38bdf8";
    var dynFont = dashboardPrefs?.FontFamily ?? "Segoe UI";
    var dynStyle = dashboardPrefs?.DashboardStyle ?? "glassmorphism";

    var customWidgetsList = new List<string>();
    if (!string.IsNullOrEmpty(dashboardPrefs?.CustomWidgetsJson))
    {
        try { customWidgetsList = System.Text.Json.JsonSerializer.Deserialize<List<string>>(dashboardPrefs.CustomWidgetsJson) ?? new List<string>(); } catch { }
    }
}

<!-- Include Sortable.js CDN for Drag-and-Drop Widget Customization -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>

<style>
    /* =========================================
           DYNAMIC USER SETTINGS (Colors & Font)
           ========================================= */
    .blog-dashboard {
        padding: 24px;
        background: @dynTheme !important;
        font-family: @dynFont !important;
        min-height: 100vh;
        border-radius: 20px;
        color: #f8fafc;
        transition: all 0.3s ease;
    }

    /* =========================================
           10 MORPHISM DESIGN STYLES ENGINE
           ========================================= */
    .style-glassmorphism .news-card, .style-glassmorphism .dashboard-hero {
        background: rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        border-radius: 20px;
    }

    .style-neumorphism .blog-dashboard {
        background: #e0e5ec !important;
        color: #333 !important;
    }

    .style-neumorphism .news-card, .style-neumorphism .dashboard-hero {
        background: #e0e5ec;
        border: none;
        box-shadow: 9px 9px 16px #a3b1c1, -9px -9px 16px #ffffff;
        border-radius: 20px;
        color: #333;
    }

    .style-claymorphism .news-card, .style-claymorphism .dashboard-hero {
        background: #f0f4f8;
        border-radius: 35px;
        box-shadow: inset 6px 6px 12px rgba(255, 255, 255, 0.8), inset -6px -6px 12px rgba(163, 177, 198, 0.6), 10px 20px 30px rgba(0,0,0,0.1);
        border: 4px solid #ffffff;
        color: #2d3748;
    }

    .style-auroramorphism .news-card, .style-auroramorphism .dashboard-hero {
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(168, 85, 247, 0.15));
        backdrop-filter: blur(20px);
        border: 2px solid;
        border-image: linear-gradient(to right, #38bdf8, #a855f7) 1;
        box-shadow: 0 0 25px rgba(168, 85, 247, 0.2);
        border-radius: 20px;
    }

    .style-skeuomorphism .news-card, .style-skeuomorphism .dashboard-hero {
        background: linear-gradient(to bottom, #f9f9f9, #e0e0e0);
        border: 1px solid #b5b5b5;
        box-shadow: 0 4px 8px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.8);
        border-radius: 12px;
        color: #111;
    }

    .style-skeuominimalism .news-card, .style-skeuominimalism .dashboard-hero {
        background: #fafafa;
        border: 1px solid #dedede;
        box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        border-radius: 16px;
        color: #222;
    }

    .style-genmorphism .news-card, .style-genmorphism .dashboard-hero {
        background: #ffe600;
        border: 3px solid #000;
        box-shadow: 6px 6px 0px #000;
        border-radius: 20px;
        color: #000;
    }

    .style-woodmorphism .blog-dashboard {
        background: #3b2314 !important;
    }

    .style-woodmorphism .news-card, .style-woodmorphism .dashboard-hero {
        background: #5c3a21;
        border: 2px solid #2b180a;
        box-shadow: 0 8px 16px rgba(0,0,0,0.5), inset 0 1px 3px rgba(255,255,255,0.1);
        border-radius: 16px;
        color: #f3e9dc;
    }

    .style-metalmorphism .blog-dashboard {
        background: #1e2229 !important;
    }

    .style-metalmorphism .news-card, .style-metalmorphism .dashboard-hero {
        background: linear-gradient(135deg, #2c313c, #1a1d24);
        border: 1px solid #4f586a;
        box-shadow: 0 10px 20px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.15);
        border-radius: 16px;
        color: #e2e8f0;
    }

    .style-papermorphism .blog-dashboard {
        background: #fdfbf7 !important;
        color: #2c2c2c !important;
    }

    .style-papermorphism .news-card, .style-papermorphism .dashboard-hero {
        background: #ffffff;
        border: 1px solid #e3dec9;
        box-shadow: 2px 4px 12px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.04);
        border-radius: 4px;
        color: #2c2c2c;
    }

    /* CUSTOMIZE TOOLBAR */
    .customize-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 12px 20px;
        border-radius: 14px;
        margin-bottom: 24px;
    }

    /* HERO SECTION */
    .dashboard-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 35px;
        margin-bottom: 28px;
    }

        .dashboard-hero h1 {
            margin: 0 0 10px;
            font-size: 34px;
            font-weight: 800;
        }

        .dashboard-hero p {
            margin: 0;
            font-size: 15px;
            line-height: 1.7;
            opacity: 0.85;
        }

    /* SEARCH */
    .dashboard-search {
        margin-top: 24px;
        max-width: 650px;
    }

    .dashboard-search-box {
        display: flex;
        align-items: center;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 14px;
        overflow: hidden;
    }

        .dashboard-search-box span {
            padding-left: 15px;
            font-size: 18px;
        }

        .dashboard-search-box input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            color: inherit;
            padding: 13px 14px;
            font-size: 14px;
        }

    /* TABS */
    .dashboard-tabs {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        margin-bottom: 22px;
        padding-bottom: 4px;
    }

    .dashboard-tab {
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05);
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
    }

        .dashboard-tab.active {
            background: @dynAccent !important;
            color: #0f172a !important;
            border-color: @dynAccent !important;
        }

    /* CATEGORY PILLS */
    .category-section {
        margin-bottom: 25px;
    }

    .category-title {
        font-size: 15px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .category-pills {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .category-pill {
        border: 1px solid rgba(255,255,255,0.15);
        background: rgba(255,255,255,0.05);
        padding: 8px 14px;
        border-radius: 999px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
    }

        .category-pill.active {
            background: @dynAccent !important;
            color: #0f172a !important;
            border-color: @dynAccent !important;
        }

    /* SECTION HEADER */
    .posts-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .posts-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 13px;
        border-radius: 999px;
        background: rgba(56, 189, 248, 0.15);
        color: @dynAccent !important;
        font-size: 12px;
        font-weight: 800;
    }

    /* NEWS GRID */
    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        min-height: 200px;
    }

    .news-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        transition: transform 0.25s ease;
    }

    .dashboard-editable .news-card {
        cursor: grab;
        border: 2px dashed @dynAccent !important;
        position: relative;
    }

        .dashboard-editable .news-card:active {
            cursor: grabbing;
        }

        .dashboard-editable .news-card::after {
            content: '⠿ Drag to reorder';
            position: absolute;
            top: 10px;
            right: 10px;
            background: @dynAccent;
            color: #0f172a;
            font-size: 10px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
            z-index: 10;
        }

    .news-card:hover {
        transform: translateY(-5px);
    }

    .news-image {
        width: 100%;
        height: 205px;
        overflow: hidden;
    }

        .news-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .news-card:hover .news-image img {
        transform: scale(1.05);
    }

    .news-image.no-image {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
    }

    .news-card-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 20px;
    }

    .news-category {
        display: inline-flex;
        align-self: flex-start;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        margin-bottom: 11px;
        background: rgba(56,189,248,0.15);
        color: @dynAccent;
    }

    .news-card-content h3 {
        margin: 0 0 9px;
        font-size: 20px;
        font-weight: 800;
    }

    .news-author {
        font-size: 12px;
        margin-bottom: 12px;
        opacity: 0.8;
    }

    .news-description {
        font-size: 14px;
        line-height: 1.7;
        margin: 0 0 20px;
        opacity: 0.9;
    }

    .news-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid rgba(255,255,255,0.08);
    }

    .news-stats {
        display: flex;
        gap: 9px;
        font-size: 11px;
        opacity: 0.8;
    }

    .read-more-btn {
        color: @dynAccent;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
    }

        .read-more-btn:hover {
            text-decoration: underline;
        }

    .no-posts {
        grid-column: 1 / -1;
        border: 1px dashed rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        padding: 60px 25px;
        text-align: center;
    }

    .no-search-result {
        display: none;
        grid-column: 1 / -1;
        text-align: center;
        padding: 45px 20px;
    }
</style>

<div class="blog-dashboard style-@dynStyle" id="mainDashboardContainer">

    <!-- CUSTOMIZATION CONTROL TOOLBAR -->
    <div class="customize-toolbar">
        <div>
            <h4 class="m-0 fw-bold">✨ Interactive Dashboard</h4>
            <small class="opacity-75">Drag & drop cards to reorder, or customize themes in Settings.</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-outline-light" id="toggleCustomizeBtn" onclick="toggleCustomizeMode()">
                ⚙️ Enable Customize Mode
            </button>
            <button type="button" class="btn btn-sm btn-success fw-bold px-3" onclick="saveDashboardLayout()">
                💾 Save Layout
            </button>
        </div>
    </div>

    <!-- WIDGET VISIBILITY CONTROLS -->
    <div id="widgetControlsPanel" class="p-3 mb-4 rounded-3" style="background: rgba(0,0,0,0.2); display: none; border: 1px dashed @dynAccent;">
        <span class="fw-bold d-block mb-2" style="color: @dynAccent;">🛠️ Toggle Dashboard Sections:</span>
        <div class="d-flex gap-3 flex-wrap">
            <label class="user-select-none"><input type="checkbox" id="toggleHero" checked onchange="toggleWidget('heroSection', this.checked)"> Welcome Banner</label>
            <label class="user-select-none"><input type="checkbox" id="toggleCategories" checked onchange="toggleWidget('categorySection', this.checked)"> Categories Filter</label>
        </div>
    </div>

    <!-- HERO -->
    <section class="dashboard-hero" id="heroSection">
        <div class="dashboard-hero-content">
            <h1>Welcome to BlogVerse 👋</h1>
            <p>Discover stories, ideas and experiences shared by the BlogVerse community.</p>

            <div class="dashboard-search">
                <div class="dashboard-search-box">
                    <span>🔍</span>
                    <input type="text" id="postSearch" placeholder="Search posts, categories or authors..." autocomplete="off" />
                </div>
            </div>
        </div>
    </section>

    <!-- TABS -->
    <div class="dashboard-tabs">
        <button type="button" class="dashboard-tab active" data-tab="all">All Posts</button>
        <button type="button" class="dashboard-tab" data-tab="latest">Latest</button>
        <button type="button" class="dashboard-tab" data-tab="popular">Popular</button>
        <button type="button" class="dashboard-tab" data-tab="trending">Trending</button>
    </div>

    <!-- CATEGORY FILTERS -->
    @{
        var categories = Model.Posts
        .Where(p => !string.IsNullOrWhiteSpace(p.Category))
        .Select(p => p.Category!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c)
        .ToList();
    }

    @if (categories.Any())
    {
        <div class="category-section" id="categorySection">
            <div class="category-title">Browse by Category</div>
            <div class="category-pills">
                <button type="button" class="category-pill active" data-category="all">All</button>
                @foreach (var category in categories)
                {
                    <button type="button" class="category-pill" data-category="@category">@category</button>
                }
            </div>
        </div>
    }

    <!-- POSTS HEADER -->
    <div class="posts-section-header">
        <h2>Latest Posts</h2>
        <span class="posts-count">@Model.Posts.Count @(Model.Posts.Count == 1 ? "Post" : "Posts")</span>
    </div>

    <!-- POSTS GRID -->
    <div class="news-grid" id="postsGrid">
        @if (Model.Posts != null && Model.Posts.Any())
        {
            @foreach (var post in Model.Posts)
            {
                var authorName = post.User != null && !string.IsNullOrWhiteSpace(post.User.Name) ? post.User.Name : "BlogVerse User";
                var postDate = post.PublishedAt ?? post.CreatedAt;
                var plainText = System.Text.RegularExpressions.Regex.Replace(post.Content ?? "", "<.*?>", string.Empty);
                plainText = System.Net.WebUtility.HtmlDecode(plainText).Trim();
                if (plainText.Length > 180) { plainText = plainText.Substring(0, 180) + "..."; }

                <article class="news-card"
                         data-id="@post.Id"
                         data-category="@post.Category"
                         data-title="@post.Title"
                         data-author="@authorName"
                         data-date="@postDate.Ticks"
                         data-views="@post.Views"
                         data-likes="@post.Likes">

                    @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                    {
                        <div class="news-image">
                            <img src="@post.ImagePath" alt="@post.Title" loading="lazy" draggable="false" />
                        </div>
                    }
                    else
                    {
                        <div class="news-image no-image"><span>📝</span></div>
                    }

                    <div class="news-card-content">
                        <span class="news-category">@(string.IsNullOrWhiteSpace(post.Category) ? "General" : post.Category)</span>
                        <h3>@post.Title</h3>
                        <div class="news-author">👤 @authorName · 📅 @postDate.ToString("MMM dd, yyyy")</div>
                        <p class="news-description">@plainText</p>

                        <div class="news-card-footer">
                            <div class="news-stats">
                                <span>👁 @post.Views</span>
                                <span>❤️ @post.Likes</span>
                                @if (!string.IsNullOrWhiteSpace(post.AttachmentPath))
                                {
                                    <span class="attachment-badge">📎</span>
                                }
                            </div>
                            <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" class="read-more-btn">Read More →</a>
                        </div>
                    </div>
                </article>
            }

            <div class="no-search-result" id="noSearchResult">
                🔍 <h3>No matching posts found</h3>
                <p>Try another title, category or author.</p>
            </div>
        }
        else
        {
            <div class="no-posts">
                <div style="font-size: 52px; margin-bottom: 12px;">📝</div>
                <h3>No Published Posts Yet</h3>
                <p>Be the first person to share something with the BlogVerse community.</p>
                <a asp-controller="Posts" asp-action="Create" class="create-post-btn">✍️ Create Your First Post</a>
            </div>
        }
    </div>

    <!-- CUSTOM ADDED WIDGETS -->
    @if (customWidgetsList.Any())
    {
        <div class="row g-4 mt-4">
            <div class="col-12"><h3 class="fw-bold mb-3">🧩 My Custom Added Widgets</h3></div>
            @foreach (var widgetName in customWidgetsList)
            {
                <div class="col-md-4">
                    <div class="news-card p-4 h-100">
                        <h4 style="color: @dynAccent;">@widgetName</h4>
                        <p class="small mb-0 opacity-75">This is a custom widget added by you through settings.</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    const savedLayoutJson = @Html.Raw(Json.Serialize(ViewBag.LayoutConfig ?? "{}"));
    let isCustomizeMode = false;

    function toggleCustomizeMode() {
        isCustomizeMode = !isCustomizeMode;
        const container = document.getElementById('mainDashboardContainer');
        const controlsPanel = document.getElementById('widgetControlsPanel');
        const btn = document.getElementById('toggleCustomizeBtn');

        if (isCustomizeMode) {
            container.classList.add('dashboard-editable');
            controlsPanel.style.display = 'block';
            btn.textContent = '✨ Disable Customize';
            btn.classList.replace('btn-outline-light', 'btn-warning');
        } else {
            container.classList.remove('dashboard-editable');
            controlsPanel.style.display = 'none';
            btn.textContent = '⚙️ Enable Customize Mode';
            btn.classList.replace('btn-warning', 'btn-outline-light');
        }
    }

    function toggleWidget(elementId, isVisible) {
        const el = document.getElementById(elementId);
        if (el) { el.style.display = isVisible ? '' : 'none'; }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const gridElement = document.getElementById("postsGrid");
        const postCards = Array.from(document.querySelectorAll(".news-card"));
        const searchInput = document.getElementById("postSearch");
        const noSearchResult = document.getElementById("noSearchResult");
        const tabButtons = document.querySelectorAll(".dashboard-tab");
        const categoryButtons = document.querySelectorAll(".category-pill");

        let selectedCategory = "all";

        if (gridElement) {
            Sortable.create(gridElement, { animation: 150, ghostClass: 'sortable-ghost' });

            try {
                const layoutData = typeof savedLayoutJson === 'string' ? JSON.parse(savedLayoutJson) : savedLayoutJson;
                if (layoutData && layoutData.cardOrder && Array.isArray(layoutData.cardOrder)) {
                    layoutData.cardOrder.forEach(postId => {
                        const card = gridElement.querySelector(`[data-id="${postId}"]`);
                        if (card) { gridElement.appendChild(card); }
                    });
                }
                if (layoutData && layoutData.visibility) {
                    if (layoutData.visibility.hero === false) {
                        document.getElementById('heroSection').style.display = 'none';
                        document.getElementById('toggleHero').checked = false;
                    }
                    if (layoutData.visibility.categories === false) {
                        document.getElementById('categorySection').style.display = 'none';
                        document.getElementById('toggleCategories').checked = false;
                    }
                }
            } catch (e) {
                console.error("Could not load custom layout preferences:", e);
            }
        }

        function filterPosts() {
            const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : "";
            let visibleCount = 0;

            postCards.forEach(function (card) {
                const title = (card.dataset.title || "").toLowerCase();
                const author = (card.dataset.author || "").toLowerCase();
                const category = (card.dataset.category || "").toLowerCase();

                const searchMatch = !searchTerm || title.includes(searchTerm) || author.includes(searchTerm) || category.includes(searchTerm);
                const categoryMatch = selectedCategory === "all" || category === selectedCategory.toLowerCase();

                const visible = searchMatch && categoryMatch;
                card.style.display = visible ? "" : "none";
                if (visible) { visibleCount++; }
            });

            if (noSearchResult) {
                noSearchResult.style.display = visibleCount === 0 ? "block" : "none";
            }
        }

        if (searchInput) { searchInput.addEventListener("input", filterPosts); }

        tabButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                tabButtons.forEach(item => item.classList.remove("active"));
                button.classList.add("active");
                filterPosts();
            });
        });

        categoryButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                categoryButtons.forEach(item => item.classList.remove("active"));
                button.classList.add("active");
                selectedCategory = button.dataset.category || "all";
                filterPosts();
            });
        });

        window.saveDashboardLayout = function () {
            const cards = Array.from(gridElement.querySelectorAll('.news-card'));
            const cardOrder = cards.map(card => card.dataset.id);

            const visibilityState = {
                hero: document.getElementById('toggleHero').checked,
                categories: document.getElementById('toggleCategories') ? document.getElementById('toggleCategories').checked : true
            };

            const layoutPayload = JSON.stringify({
                cardOrder: cardOrder,
                visibility: visibilityState,
                updatedAt: new Date().toISOString()
            });

            fetch('/Dashboard/SaveLayout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(layoutPayload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert('✨ Your custom dashboard layout and preferences were saved successfully!');
                    if (isCustomizeMode) toggleCustomizeMode();
                } else {
                    alert('Failed to save layout preferences.');
                }
            })
            .catch(err => { console.error('Error saving layout:', err); });
        };
    });
</script>