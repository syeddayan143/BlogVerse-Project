@model BlogVerse.ViewModels.DashboardViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard";

    var posts = Model.Posts ?? new List<BlogVerse.Models.Post>();

    var categories = posts
        .Where(p => !string.IsNullOrWhiteSpace(p.Category))
        .Select(p => p.Category!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(c => c)
        .ToList();
}

<style>
    /* =========================================================
           LIQUID GLASS DASHBOARD
           ========================================================= */

    .blog-dashboard {
        min-height: 100vh;
        padding: 28px;
        color: #1f2937;
        background: radial-gradient(circle at 10% 10%, rgba(255,255,255,.95), transparent 30%), radial-gradient(circle at 90% 15%, rgba(220,225,230,.7), transparent 30%), linear-gradient(135deg, #eef1f4, #dfe4e8 55%, #f7f8f9);
    }

    /* =========================================================
           GLASS BASE
           ========================================================= */

    .glass-panel {
        background: rgba(255, 255, 255, 0.48);
        border: 1px solid rgba(255, 255, 255, 0.72);
        box-shadow: 0 18px 45px rgba(31, 41, 55, 0.08), inset 0 1px 0 rgba(255,255,255,.8);
        backdrop-filter: blur(24px) saturate(135%);
        -webkit-backdrop-filter: blur(24px) saturate(135%);
    }

    /* =========================================================
           HERO
           ========================================================= */

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        padding: 34px;
        margin-bottom: 24px;
        border-radius: 30px;
        background: linear-gradient( 135deg, rgba(255,255,255,.68), rgba(255,255,255,.35) );
        border: 1px solid rgba(255,255,255,.78);
        box-shadow: 0 25px 60px rgba(31,41,55,.10), inset 0 1px 0 rgba(255,255,255,.9);
        backdrop-filter: blur(30px) saturate(140%);
        -webkit-backdrop-filter: blur(30px) saturate(140%);
    }

        .dashboard-hero::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            background: rgba(255,255,255,.38);
            top: -120px;
            right: -60px;
            filter: blur(5px);
        }

        .dashboard-hero::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(255,255,255,.25);
            bottom: -90px;
            left: 20%;
            filter: blur(8px);
        }

    .dashboard-hero-content {
        position: relative;
        z-index: 2;
    }

    .dashboard-hero h1 {
        margin: 0 0 8px;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -1px;
        color: #111827;
    }

    .dashboard-hero p {
        margin: 0;
        color: #6b7280;
        font-size: 15px;
        line-height: 1.7;
    }

    /* =========================================================
           SEARCH
           ========================================================= */

    .dashboard-search {
        max-width: 680px;
        margin-top: 24px;
    }

    .dashboard-search-box {
        display: flex;
        align-items: center;
        min-height: 54px;
        padding: 0 16px;
        border-radius: 18px;
        background: rgba(255,255,255,.62);
        border: 1px solid rgba(255,255,255,.85);
        box-shadow: inset 0 1px 3px rgba(255,255,255,.9), 0 8px 25px rgba(31,41,55,.06);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

        .dashboard-search-box span {
            font-size: 18px;
            opacity: .55;
        }

        .dashboard-search-box input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            padding: 14px;
            font-size: 14px;
            color: #111827;
        }

            .dashboard-search-box input::placeholder {
                color: #9ca3af;
            }

    /* =========================================================
           TABS
           ========================================================= */

    .dashboard-tabs {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        margin-bottom: 22px;
        padding: 4px 2px 8px;
        scrollbar-width: none;
    }

        .dashboard-tabs::-webkit-scrollbar {
            display: none;
        }

    .dashboard-tab {
        border: 1px solid rgba(255,255,255,.72);
        background: rgba(255,255,255,.38);
        color: #4b5563;
        padding: 11px 20px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
    }

        .dashboard-tab:hover {
            transform: translateY(-2px);
            background: rgba(255,255,255,.68);
            box-shadow: 0 8px 20px rgba(31,41,55,.08);
        }

        .dashboard-tab.active {
            color: #111827;
            background: rgba(255,255,255,.82);
            box-shadow: 0 8px 25px rgba(31,41,55,.10), inset 0 1px 0 rgba(255,255,255,.95);
        }

    /* =========================================================
           CATEGORY
           ========================================================= */

    .category-section {
        margin-bottom: 28px;
        padding: 22px;
        border-radius: 24px;
        background: rgba(255,255,255,.34);
        border: 1px solid rgba(255,255,255,.65);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .category-title {
        margin-bottom: 13px;
        font-size: 14px;
        font-weight: 800;
        color: #374151;
    }

    .category-pills {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .category-pill {
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.42);
        color: #4b5563;
        padding: 8px 15px;
        border-radius: 999px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 650;
        transition: all .25s ease;
    }

        .category-pill:hover {
            background: rgba(255,255,255,.72);
            transform: translateY(-2px);
        }

        .category-pill.active {
            background: rgba(255,255,255,.88);
            color: #111827;
            box-shadow: 0 7px 18px rgba(31,41,55,.08);
        }

    /* =========================================================
           POSTS HEADER
           ========================================================= */

    .posts-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .posts-section-header h2 {
            margin: 0;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -.5px;
            color: #111827;
        }

    .posts-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.58);
        border: 1px solid rgba(255,255,255,.7);
        color: #4b5563;
        font-size: 12px;
        font-weight: 800;
        box-shadow: 0 7px 18px rgba(31,41,55,.06);
    }

    /* =========================================================
           POSTS GRID
           ========================================================= */

    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    /* =========================================================
           POST CARD
           ========================================================= */

    .news-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        border-radius: 26px;
        background: rgba(255,255,255,.46);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 16px 40px rgba(31,41,55,.08), inset 0 1px 0 rgba(255,255,255,.85);
        backdrop-filter: blur(22px) saturate(130%);
        -webkit-backdrop-filter: blur(22px) saturate(130%);
        transition: transform .35s ease, box-shadow .35s ease, background .35s ease;
    }

        .news-card:hover {
            transform: translateY(-7px);
            background: rgba(255,255,255,.62);
            box-shadow: 0 25px 55px rgba(31,41,55,.13), inset 0 1px 0 rgba(255,255,255,.95);
        }

    /* =========================================================
           IMAGE
           ========================================================= */

    .news-image {
        width: 100%;
        height: 205px;
        overflow: hidden;
        background: rgba(255,255,255,.35);
    }

        .news-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s ease;
        }

    .news-card:hover .news-image img {
        transform: scale(1.045);
    }

    .news-image.no-image {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 46px;
        background: linear-gradient( 135deg, rgba(255,255,255,.58), rgba(220,225,230,.45) );
    }

    /* =========================================================
           CARD CONTENT
           ========================================================= */

    .news-card-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 21px;
    }

    .news-category {
        display: inline-flex;
        align-self: flex-start;
        padding: 6px 11px;
        margin-bottom: 11px;
        border-radius: 999px;
        background: rgba(255,255,255,.62);
        border: 1px solid rgba(255,255,255,.75);
        color: #4b5563;
        font-size: 11px;
        font-weight: 800;
    }

    .news-card-content h3 {
        margin: 0 0 9px;
        color: #111827;
        font-size: 20px;
        line-height: 1.25;
        font-weight: 800;
    }

    .news-author {
        margin-bottom: 12px;
        color: #6b7280;
        font-size: 12px;
    }

    .news-description {
        margin: 0 0 20px;
        color: #4b5563;
        font-size: 14px;
        line-height: 1.7;
    }

    /* =========================================================
           CARD FOOTER
           ========================================================= */

    .news-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid rgba(107,114,128,.13);
    }

    .news-stats {
        display: flex;
        gap: 10px;
        color: #6b7280;
        font-size: 11px;
    }

    .read-more-btn {
        color: #374151;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: opacity .2s ease;
    }

        .read-more-btn:hover {
            color: #111827;
            opacity: .7;
        }

    .attachment-badge {
        opacity: .7;
    }

    /* =========================================================
           EMPTY STATES
           ========================================================= */

    .no-posts,
    .no-search-result {
        grid-column: 1 / -1;
        padding: 60px 25px;
        text-align: center;
        border-radius: 26px;
        background: rgba(255,255,255,.40);
        border: 1px solid rgba(255,255,255,.7);
        box-shadow: 0 18px 40px rgba(31,41,55,.07);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

        .no-posts h3,
        .no-search-result h3 {
            color: #111827;
            font-weight: 800;
        }

        .no-posts p,
        .no-search-result p {
            color: #6b7280;
        }

    .create-post-btn {
        display: inline-flex;
        align-items: center;
        margin-top: 12px;
        padding: 11px 18px;
        border-radius: 999px;
        background: rgba(255,255,255,.78);
        border: 1px solid rgba(255,255,255,.9);
        color: #111827;
        text-decoration: none;
        font-weight: 700;
        box-shadow: 0 8px 22px rgba(31,41,55,.08);
        transition: transform .25s ease;
    }

        .create-post-btn:hover {
            transform: translateY(-2px);
            color: #111827;
        }

    /* =========================================================
           CUSTOM WIDGETS
           ========================================================= */

    .custom-widget-section {
        margin-top: 28px;
    }

    .custom-widget-title {
        color: #111827;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .custom-widget-card {
        height: 100%;
        padding: 22px;
        border-radius: 24px;
        background: rgba(255,255,255,.43);
        border: 1px solid rgba(255,255,255,.72);
        box-shadow: 0 15px 35px rgba(31,41,55,.07);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1200px) {
        .news-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .blog-dashboard {
            padding: 16px;
        }

        .dashboard-hero {
            padding: 25px;
            border-radius: 24px;
        }

            .dashboard-hero h1 {
                font-size: 27px;
            }

        .news-grid {
            grid-template-columns: 1fr;
        }

        .posts-section-header h2 {
            font-size: 23px;
        }
    }

    @@media (max-width: 480px) {
        .blog-dashboard {
            padding: 11px;
        }

        .dashboard-hero {
            padding: 21px;
        }

        .dashboard-tabs {
            gap: 7px;
        }

        .dashboard-tab {
            padding: 9px 15px;
        }

        .news-image {
            height: 190px;
        }

        .news-card-content {
            padding: 18px;
        }
    }
</style>

<div class="blog-dashboard" id="mainDashboardContainer">

    <!-- HERO -->
    <section class="dashboard-hero" id="heroSection">

        <div class="dashboard-hero-content">

            <h1>Welcome to BlogVerse 👋</h1>

            <p>
                Discover stories, ideas and experiences shared by the BlogVerse community.
            </p>

            <div class="dashboard-search">

                <div class="dashboard-search-box">

                    <span>🔍</span>

                    <input type="text"
                           id="postSearch"
                           placeholder="Search posts, categories or authors..."
                           autocomplete="off" />

                </div>

            </div>

        </div>

    </section>


    <!-- TABS -->
    <div class="dashboard-tabs">

        <button type="button"
                class="dashboard-tab active"
                data-tab="all">

            All Posts

        </button>

        <button type="button"
                class="dashboard-tab"
                data-tab="latest">

            Latest

        </button>

        <button type="button"
                class="dashboard-tab"
                data-tab="popular">

            Popular

        </button>

        <button type="button"
                class="dashboard-tab"
                data-tab="trending">

            Trending

        </button>

    </div>


    <!-- CATEGORY FILTER -->
    @if (categories.Any())
    {
        <div class="category-section" id="categorySection">

            <div class="category-title">
                Browse by Category
            </div>

            <div class="category-pills">

                <button type="button"
                        class="category-pill active"
                        data-category="all">

                    All

                </button>

                @foreach (var category in categories)
                {
                    <button type="button"
                            class="category-pill"
                            data-category="@category">

                        @category

                    </button>
                }

            </div>

        </div>
    }


    <!-- POSTS HEADER -->
    <div class="posts-section-header">

        <h2 id="postsHeading">
            Latest Posts
        </h2>

        <span class="posts-count">
            @posts.Count @(posts.Count == 1 ? "Post" : "Posts")
        </span>

    </div>


    <!-- POSTS GRID -->
    <div class="news-grid" id="postsGrid">

        @if (posts.Any())
        {
            foreach (var post in posts)
            {
                var authorName =
                post.User != null &&
                !string.IsNullOrWhiteSpace(post.User.Name)
                ? post.User.Name
                : "BlogVerse User";

                var postDate = post.PublishedAt ?? post.CreatedAt;

                var plainText =
                System.Text.RegularExpressions.Regex.Replace(
                post.Content ?? string.Empty,
                "<.*?>",
                string.Empty
                );

                plainText =
                System.Net.WebUtility.HtmlDecode(plainText).Trim();

                if (plainText.Length > 180)
                {
                    plainText = plainText.Substring(0, 180) + "...";
                }

                <article class="news-card"
                         data-id="@post.Id"
                         data-category="@post.Category"
                         data-title="@post.Title"
                         data-author="@authorName"
                         data-date="@postDate.Ticks"
                         data-views="@post.Views"
                         data-likes="@post.Likes">

                    @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                    {
                        <div class="news-image">

                            <img src="@post.ImagePath"
                                 alt="@post.Title"
                                 loading="lazy"
                                 draggable="false" />

                        </div>
                    }
                    else
                    {
                        <div class="news-image no-image">

                            <span>📝</span>

                        </div>
                    }


            <div class="news-card-content">

                <span class="news-category">

                    @(string.IsNullOrWhiteSpace(post.Category)
                                        ? "General"
                                        : post.Category)

                </span>


                        <h3>
                            @post.Title
                        </h3>


                        <div class="news-author">

                            👤 @authorName
                            ·
                            📅 @postDate.ToString("MMM dd, yyyy")

                        </div>


                        <p class="news-description">
                            @plainText
                        </p>


                        <div class="news-card-footer">

                            <div class="news-stats">

                                <span>
                                    👁 @post.Views
                                </span>

                                <span>
                                    ❤️ @post.Likes
                                </span>

                        @if (!string.IsNullOrWhiteSpace(post.AttachmentPath))
                                {
                                    <span class="attachment-badge">
                                        📎
                                    </span>
                                }

                            </div>


                            <a asp-controller="Posts"
                               asp-action="Details"
                               asp-route-id="@post.Id"
                               class="read-more-btn">

                                Read More →

                            </a>

                        </div>

                    </div>

                </article>
            }


            <div class="no-search-result" id="noSearchResult">

                <div style="font-size:42px;">
                    🔍
                </div>

                <h3>
                    No matching posts found
                </h3>

                <p>
                    Try another title, category or author.
                </p>

            </div>

        }
        else
        {
            <div class="no-posts">

                <div style="font-size:52px; margin-bottom:12px;">
                    📝
                </div>

                <h3>
                    No Published Posts Yet
                </h3>

                <p>
                    Be the first person to share something with the BlogVerse community.
                </p>

                <a asp-controller="Posts"
                   asp-action="Create"
                   class="create-post-btn">

                    ✍️ Create Your First Post

                </a>

            </div>
        }

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const grid = document.getElementById("postsGrid");

        const searchInput =
            document.getElementById("postSearch");

        const noSearchResult =
            document.getElementById("noSearchResult");

        const postCards =
            Array.from(
                document.querySelectorAll(".news-card")
            );

        const tabButtons =
            document.querySelectorAll(".dashboard-tab");

        const categoryButtons =
            document.querySelectorAll(".category-pill");

        const postsHeading =
            document.getElementById("postsHeading");


        let selectedCategory = "all";

        let selectedTab = "all";


        /* =====================================================
           SORT POSTS
           ===================================================== */

        function sortPosts() {

            if (!grid) {
                return;
            }

            const cards =
                Array.from(
                    grid.querySelectorAll(".news-card")
                );

            cards.sort(function (a, b) {

                const dateA =
                    Number(a.dataset.date || 0);

                const dateB =
                    Number(b.dataset.date || 0);

                const viewsA =
                    Number(a.dataset.views || 0);

                const viewsB =
                    Number(b.dataset.views || 0);

                const likesA =
                    Number(a.dataset.likes || 0);

                const likesB =
                    Number(b.dataset.likes || 0);


                if (selectedTab === "latest") {

                    return dateB - dateA;

                }


                if (selectedTab === "popular") {

                    const scoreA =
                        (likesA * 3) + viewsA;

                    const scoreB =
                        (likesB * 3) + viewsB;

                    return scoreB - scoreA;

                }


                if (selectedTab === "trending") {

                    const scoreA =
                        (likesA * 5) + (viewsA * 2);

                    const scoreB =
                        (likesB * 5) + (viewsB * 2);

                    return scoreB - scoreA;

                }


                return dateB - dateA;

            });


            cards.forEach(function (card) {

                grid.appendChild(card);

            });

        }


        /* =====================================================
           FILTER POSTS
           ===================================================== */

        function filterPosts() {

            const searchTerm =
                searchInput
                    ? searchInput.value.toLowerCase().trim()
                    : "";

            let visibleCount = 0;


            postCards.forEach(function (card) {

                const title =
                    (card.dataset.title || "")
                        .toLowerCase();

                const author =
                    (card.dataset.author || "")
                        .toLowerCase();

                const category =
                    (card.dataset.category || "")
                        .toLowerCase();


                const searchMatch =
                    !searchTerm ||
                    title.includes(searchTerm) ||
                    author.includes(searchTerm) ||
                    category.includes(searchTerm);


                const categoryMatch =
                    selectedCategory === "all" ||
                    category === selectedCategory.toLowerCase();


                const visible =
                    searchMatch && categoryMatch;


                card.style.display =
                    visible ? "" : "none";


                if (visible) {

                    visibleCount++;

                }

            });


            if (noSearchResult) {

                noSearchResult.style.display =
                    visibleCount === 0
                        ? "block"
                        : "none";

            }

        }


        /* =====================================================
           SEARCH
           ===================================================== */

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                filterPosts
            );

        }


        /* =====================================================
           TABS
           ===================================================== */

        tabButtons.forEach(function (button) {

            button.addEventListener(
                "click",
                function () {

                    tabButtons.forEach(function (item) {

                        item.classList.remove("active");

                    });


                    button.classList.add("active");


                    selectedTab =
                        button.dataset.tab || "all";


                    if (postsHeading) {

                        if (selectedTab === "latest") {

                            postsHeading.textContent =
                                "Latest Posts";

                        }
                        else if (selectedTab === "popular") {

                            postsHeading.textContent =
                                "Popular Posts";

                        }
                        else if (selectedTab === "trending") {

                            postsHeading.textContent =
                                "Trending Posts";

                        }
                        else {

                            postsHeading.textContent =
                                "Latest Posts";

                        }

                    }


                    sortPosts();

                    filterPosts();

                }
            );

        });


        /* =====================================================
           CATEGORY
           ===================================================== */

        categoryButtons.forEach(function (button) {

            button.addEventListener(
                "click",
                function () {

                    categoryButtons.forEach(function (item) {

                        item.classList.remove("active");

                    });


                    button.classList.add("active");


                    selectedCategory =
                        button.dataset.category || "all";


                    filterPosts();

                }
            );

        });


        /* INITIAL */
        sortPosts();

        filterPosts();

    });

</script>