@model IEnumerable<BlogVerse.Models.PostView>

@{
    ViewData["Title"] = "History";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .history-page {
        padding: 28px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .history-header {
        margin-bottom: 28px;
    }

        .history-header h1 {
            margin: 0 0 8px;
            color: #1f1f1f;
            font-size: 34px;
            font-weight: 700;
            letter-spacing: -0.8px;
        }

        .history-header p {
            margin: 0;
            color: #777;
            font-size: 15px;
        }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .history-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.74);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .history-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 38px rgba(0, 0, 0, 0.09);
        }

    .history-icon {
        flex: 0 0 52px;
        width: 52px;
        height: 52px;
        border-radius: 17px;
        background: #eeeeee;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .history-content {
        min-width: 0;
        flex: 1;
    }

    .history-category {
        display: inline-block;
        margin-bottom: 7px;
        padding: 5px 10px;
        border-radius: 999px;
        background: #eeeeee;
        color: #555;
        font-size: 11px;
        font-weight: 600;
    }

    .history-title {
        margin: 0 0 7px;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.35;
        color: #1d1d1d;
    }

        .history-title a {
            color: inherit;
            text-decoration: none;
        }

            .history-title a:hover {
                text-decoration: underline;
                text-underline-offset: 4px;
            }

    .history-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 13px;
        color: #777;
        font-size: 12px;
    }

        .history-meta strong {
            color: #333;
        }

    .history-action {
        flex: 0 0 auto;
    }

    .read-history-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border-radius: 13px;
        background: #222;
        color: #fff;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .read-history-btn:hover {
            background: #000;
            color: #fff;
            transform: translateY(-1px);
        }

    .empty-state {
        padding: 65px 25px;
        text-align: center;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        border-radius: 20px;
        background: #eeeeee;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #222;
        font-size: 21px;
    }

    .empty-state p {
        margin: 0;
        color: #777;
        font-size: 14px;
    }

    @@media (max-width: 700px) {
        .history-page {
            padding: 18px;
        }

        .history-header h1 {
            font-size: 28px;
        }

        .history-card {
            align-items: flex-start;
            padding: 17px;
            gap: 14px;
            border-radius: 19px;
        }

        .history-icon {
            flex: 0 0 44px;
            width: 44px;
            height: 44px;
            border-radius: 14px;
            font-size: 18px;
        }

        .history-title {
            font-size: 17px;
        }

        .history-action {
            display: none;
        }
    }

    @@media (max-width: 450px) {
        .history-meta {
            flex-direction: column;
            gap: 5px;
        }
    }
</style>

<div class="history-page">

    <!-- HEADER -->
    <div class="history-header">
        <h1>History</h1>
        <p>Posts you have recently viewed.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="history-list">

            @foreach (var history in Model)
            {
                var post = history.Post;

                if (post == null)
                {
                    continue;
                }

                <article class="history-card">

                    <!-- ICON -->
                    <div class="history-icon">
                        ◷
                    </div>

                    <!-- CONTENT -->
                    <div class="history-content">

                        @if (!string.IsNullOrWhiteSpace(post.Category))
                        {
                            <span class="history-category">
                                @post.Category
                            </span>
                        }

                        <h2 class="history-title">
                            <a asp-controller="Posts"
                               asp-action="Details"
                               asp-route-id="@post.Id">
                                @post.Title
                            </a>
                        </h2>

                        <div class="history-meta">

                            <span>
                                👤
                                <strong>
                                    @(post.User?.Name ?? "Unknown User")
                                </strong>
                            </span>

                            <span>
                                👁
                                <strong>@post.Views</strong> views
                            </span>

                            <span>
                                ♥
                                <strong>@post.Likes</strong> likes
                            </span>

                            <span>
                                Viewed:
                                <strong>
                                    @history.ViewedAt.ToLocalTime()
                                    .ToString("dd MMM yyyy, hh:mm tt")
                                </strong>
                            </span>

                        </div>

                    </div>

                    <!-- ACTION -->
                    <div class="history-action">

                        <a asp-controller="Posts"
                           asp-action="Details"
                           asp-route-id="@post.Id"
                           class="read-history-btn">
                            Open →
                        </a>

                    </div>

                </article>
            }

        </div>
    }
    else
    {
        <!-- EMPTY STATE -->
        <div class="empty-state">

            <div class="empty-icon">
                ◷
            </div>

            <h3>No history yet</h3>

            <p>
                Posts that you view will appear here.
            </p>

        </div>
    }

</div>