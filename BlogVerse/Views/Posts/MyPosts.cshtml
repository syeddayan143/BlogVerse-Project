                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="#">
                    Trending
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="#">
                    For You
                </a>
            </li>

        </ul>

    </section>


    <!-- =========================================
         CATEGORY FILTER
    ========================================== -->

