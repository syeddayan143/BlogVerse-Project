                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="#">
                    Politics
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="#">
                    Technology
                </a>
            </li>

            <li class="nav-item">
