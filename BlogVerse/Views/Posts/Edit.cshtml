@model BlogVerse.Models.EditPostViewModel

@{
    ViewData["Title"] = "Edit Post";
}

<h2>Edit Your Post</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">

    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Category" class="control-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Content" class="control-label"></label>
        <textarea asp-for="Content" class="form-control"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <!-- Existing Image -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="form-group">
            <label>Current Image</label>
            <div style="margin-bottom: 10px;">
                <img src="@Model.ImagePath"
                     alt="Current Post Image"
                     style="max-width: 250px; max-height: 180px; border-radius: 10px;" />
            </div>
        </div>
    }

    <!-- Replace Image -->
    <div class="form-group">
        <label asp-for="Image" class="control-label">
            Replace Image (optional)
        </label>

        <input asp-for="Image"
               type="file"
               class="form-control"
               accept=".jpg,.jpeg,.png,.gif,.webp" />

        <small class="text-muted">
            Leave empty if you want to keep the current image.
        </small>

        <span asp-validation-for="Image" class="text-danger"></span>
    </div>

    <!-- Existing Attachment -->
    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
    {
        <div class="form-group" style="margin-top: 20px;">
            <label>Current Attachment</label>

            <div style="
                    padding: 12px;
                    background: #f5f5f5;
                    border-radius: 8px;
                    margin-top: 8px;
                ">
                📎
                <strong>@Model.AttachmentName</strong>

                <br />

                <a href="@Model.AttachmentPath"
                   target="_blank"
                   class="btn btn-sm btn-outline-primary"
                   style="margin-top: 8px;">
                    View / Download
                </a>
            </div>
        </div>
    }

    <!-- Replace / Add Attachment -->
    <div class="form-group" style="margin-top: 20px;">
        <label asp-for="Attachment" class="control-label">
            Upload / Replace File
        </label>

        <input asp-for="Attachment"
               type="file"
               class="form-control"
               accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,.txt,.rtf,.json,.xml,.zip,.rar,.jpg,.jpeg,.png,.gif,.webp,.mp3,.wav,.mp4,.mov,.avi" />

        <small class="text-muted">
            Leave empty if you want to keep the current attachment.
            <br />
            <strong>Allowed:</strong>
            PDF, Word, Excel, CSV, PowerPoint, TXT, JSON, XML,
            ZIP, RAR, Images, Audio and Video
            <br />
            <strong>Maximum size:</strong> 25 MB
        </small>

        <span asp-validation-for="Attachment" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        tinymce.init({
            selector: '#Content',
            height: 400,
            menubar: false,
            plugins: 'lists link image code table',
            toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image | code',
            content_style: 'body { font-family:Arial,sans-serif; font-size:16px; }'
        });
    </script>
}