@model IEnumerable<BlogVerse.Models.ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    string currentStatus = ViewBag.Status as string ?? "";
    string currentSearch = ViewBag.Search as string ?? "";
}

<style>

    .users-page {
        padding: 25px;
    }

    /* HEADER */

    .users-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .users-title h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
    }

    .users-title p {
        margin-top: 7px;
        color: #777;
    }

    /* SEARCH */

    .filter-box {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        .filter-box input,
        .filter-box select {
            padding: 11px 14px;
            border: 1px solid #ddd;
            border-radius: 10px;
            background: white;
            outline: none;
        }

        .filter-box input {
            width: 260px;
        }

        .filter-box button {
            border: none;
            padding: 11px 20px;
            border-radius: 10px;
            background: #222;
            color: white;
            cursor: pointer;
        }

    .clear-btn {
        display: inline-flex;
        align-items: center;
        padding: 11px 15px;
        border-radius: 10px;
        background: #f1f1f1;
        color: #333;
        text-decoration: none;
    }

    /* STATISTICS */

    .user-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .user-stat {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 7px 25px rgba(0,0,0,0.06);
    }

        .user-stat h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .user-stat p {
            margin: 5px 0 0;
            color: #777;
        }

    /* TABLE */

    .users-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.07);
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

        .users-table th {
            background: #f7f7f7;
            padding: 16px;
            text-align: left;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #666;
        }

        .users-table td {
            padding: 17px 16px;
            border-top: 1px solid #eee;
            vertical-align: middle;
        }

    /* USER */

    .user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #B9B1CD;
        color: #222;
        font-weight: 700;
        flex-shrink: 0;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-name {
        font-weight: 600;
    }

    .user-email {
        color: #777;
        font-size: 13px;
    }

    /* STATUS */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-active {
        background: #e8f8ee;
        color: #218838;
    }

    .status-inactive {
        background: #fbeaea;
        color: #dc3545;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
    }

    /* ACTION AREA */

    .actions-wrapper {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-form {
        margin: 0;
    }

    /* VIEW DETAILS */

    .btn-details {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 9px 13px;
        border-radius: 9px;
        background: #222;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-details:hover {
            background: #000;
            color: white;
            transform: translateY(-1px);
        }

    /* STATUS BUTTON */

    .btn-status {
        border: none;
        padding: 9px 15px;
        border-radius: 9px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: transform 0.2s ease;
    }

        .btn-status:hover {
            transform: translateY(-1px);
        }

    .btn-deactivate {
        background: #fff0f0;
        color: #dc3545;
    }

    .btn-activate {
        background: #eaf8ef;
        color: #218838;
    }

    .btn-disabled {
        background: #eeeeee;
        color: #999;
        cursor: not-allowed;
    }

    /* ALERTS */

    .custom-alert {
        border: none;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    /* EMPTY */

    .empty-users {
        text-align: center;
        padding: 60px 20px;
        color: #777;
    }

    /* RESPONSIVE */

    @@media (max-width: 1000px) {

        .user-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .users-table {
            min-width: 850px;
        }
    }

    @@media (max-width: 700px) {

        .users-page {
            padding: 15px;
        }

        .users-title h1 {
            font-size: 26px;
        }

        .user-stats {
            grid-template-columns: 1fr;
        }

        .filter-box {
            width: 100%;
        }

            .filter-box input {
                width: 100%;
            }

            .filter-box select {
                flex: 1;
            }

            .filter-box button,
            .clear-btn {
                flex: 1;
                justify-content: center;
            }
    }

</style>


<div class="users-page">


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="users-header">

        <div class="users-title">

            <h1>
                👥 User Management
            </h1>

            <p>
                Manage registered BlogVerse users.
            </p>

        </div>


        <!-- FILTER -->

        <form asp-action="Index"
              method="get"
              class="filter-box">

            <input type="text"
                   name="search"
                   value="@currentSearch"
                   placeholder="Search name or email..." />


            <select name="status">

                <option value=""
                        selected="@(string.IsNullOrEmpty(currentStatus))">
                    All Users
                </option>

                <option value="active"
                        selected="@(currentStatus == "active")">
                    Active
                </option>

                <option value="inactive"
                        selected="@(currentStatus == "inactive")">
                    Deactivated
                </option>

            </select>


            <button type="submit">
                Search
            </button>


            @if (!string.IsNullOrWhiteSpace(currentSearch) ||
                        !string.IsNullOrWhiteSpace(currentStatus))
            {
                <a asp-action="Index"
                   class="clear-btn">

                    Clear

                </a>
            }

        </form>

    </div>


    <!-- =================================================
         ALERTS
    ================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success custom-alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger custom-alert">
            @TempData["Error"]
        </div>
    }


    <!-- =================================================
         STATISTICS
    ================================================== -->

    <div class="user-stats">

        <div class="user-stat">

            <h2>
                @ViewBag.TotalUsers
            </h2>

            <p>
                Total Users
            </p>

        </div>


        <div class="user-stat">

            <h2>
                @ViewBag.ActiveUsers
            </h2>

            <p>
                Active Users
            </p>

        </div>


        <div class="user-stat">

            <h2>
                @ViewBag.DeactivatedUsers
            </h2>

            <p>
                Deactivated Users
            </p>

        </div>

    </div>


    <!-- =================================================
         USERS TABLE
    ================================================== -->

    <div class="users-card">

        @if (Model != null && Model.Any())
        {
            <div class="table-wrapper">

                <table class="users-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                User
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int count = 1;
                        }


                        @foreach (var user in Model)
                        {
                            var initial =
                            !string.IsNullOrWhiteSpace(user.Name)
                            ? user.Name.Substring(0, 1).ToUpper()
                            : "?";


                            var currentUserId =
                            User.FindFirst(
                            System.Security.Claims.ClaimTypes.NameIdentifier
                            )?.Value;


                            bool isCurrentUser =
                            user.Id == currentUserId;


                            <tr>

                                <!-- NUMBER -->

                                <td>
                                    @count
                                </td>


                                <!-- USER -->

                                <td>

                                    <div class="user-info">

                                        <div class="user-avatar">
                                            @initial
                                        </div>

                                        <div>

                                            <div class="user-name">
                                                @user.Name
                                            </div>

                                            @if (isCurrentUser)
                                            {
                                                <small class="text-muted">
                                                    Administrator
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    <div class="user-email">
                                        @user.Email
                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (user.IsActive)
                                    {
                                        <span class="status status-active">

                                            <span class="status-dot"></span>

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status-inactive">

                                            <span class="status-dot"></span>

                                            Deactivated

                                        </span>
                                    }

                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="actions-wrapper">


                                        <!-- VIEW DETAILS -->

                                        <a asp-controller="Users"
                                           asp-action="Details"
                                           asp-route-id="@user.Id"
                                           class="btn-details">

                                            👁 View Details

                                        </a>


                                        <!-- ACTIVATE / DEACTIVATE -->
                                        @if (isCurrentUser)
                                        {
                                            <button type="button"
                                                    class="btn-status btn-disabled"
                                                    disabled>

                                                Current Admin

                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleStatus"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@user.Id" />


                                                @if (user.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn-status btn-deactivate"
                                                            onclick="return confirm('Deactivate this user account?');">

                                                        Deactivate

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn-status btn-activate"
                                                            onclick="return confirm('Activate this user account?');">

                                                        Activate

                                                    </button>
                                                }

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>


                            count++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-users">

                <h3>
                    No users found
                </h3>

                <p>
                    No registered users match your search.
                </p>

            </div>
        }

    </div>

</div>