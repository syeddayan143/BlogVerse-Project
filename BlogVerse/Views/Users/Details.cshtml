@model BlogVerse.Models.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var currentUserId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier
    )?.Value;

    bool isCurrentUser = Model.Id == currentUserId;
}

<style>

    /* =====================================================
               MAIN PAGE
            ===================================================== */

    .user-details-page {
        padding: 10px 0 40px;
    }


    /* =====================================================
               HEADER
            ===================================================== */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #111;
        }

        .page-header p {
            margin: 5px 0 0;
            color: #777;
            font-size: 14px;
        }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 10px;
        background: #111;
        color: white;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s ease;
        white-space: nowrap;
    }

        .back-btn:hover {
            color: white;
            background: #000;
            transform: translateY(-1px);
        }


    /* =====================================================
               PROFILE CARD
            ===================================================== */

    .profile-card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.07);
        border: 1px solid #eee;
    }

    .profile-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .profile-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .user-avatar {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #111;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        flex-shrink: 0;
        overflow: hidden;
    }

        .user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            display: block;
        }

    .user-info {
        min-width: 0;
    }

        .user-info h2 {
            margin: 0 0 5px;
            font-size: 23px;
            font-weight: 700;
            color: #111;
            word-break: break-word;
        }

    .user-email {
        color: #777;
        font-size: 14px;
        margin-bottom: 10px;
        word-break: break-word;
    }


    /* =====================================================
               STATUS
            ===================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active {
        background: #e8f8ee;
        color: #218838;
    }

    .status-inactive {
        background: #fdeaea;
        color: #c62828;
    }


    /* =====================================================
               PROFILE ACTION
            ===================================================== */

    .profile-action form {
        margin: 0;
    }

    .status-btn {
        border: none;
        border-radius: 10px;
        padding: 11px 18px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: 0.2s ease;
        white-space: nowrap;
    }

    .deactivate-btn {
        background: #dc3545;
        color: white;
    }

    .activate-btn {
        background: #198754;
        color: white;
    }

    .status-btn:hover {
        transform: translateY(-1px);
        opacity: 0.9;
    }


    /* =====================================================
               STATISTICS
            ===================================================== */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        border: 1px solid #eee;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }

    .stat-label {
        color: #777;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .stat-number {
        color: #111;
        font-size: 26px;
        font-weight: 700;
    }


    /* =====================================================
               POSTS CARD
            ===================================================== */

    .posts-card {
        background: white;
        border-radius: 18px;
        border: 1px solid #eee;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
        overflow: hidden;
    }

    .posts-header {
        padding: 20px 22px;
        border-bottom: 1px solid #eee;
    }

        .posts-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            color: #111;
        }

        .posts-header p {
            margin: 5px 0 0;
            color: #777;
            font-size: 13px;
        }


    /* =====================================================
               FULL POST LIST
            ===================================================== */

    .user-posts-list {
        padding: 20px;
    }


    /* =====================================================
               FULL POST CARD
            ===================================================== */

    .full-post-card {
        border: 1px solid #e8e8e8;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 20px;
        background: #fff;
    }

        .full-post-card:last-child {
            margin-bottom: 0;
        }


    /* =====================================================
               POST HEADER
            ===================================================== */

    .full-post-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding: 22px;
        border-bottom: 1px solid #eee;
    }

    .full-post-title-area {
        min-width: 0;
        flex: 1;
    }

        .full-post-title-area h3 {
            margin: 0 0 12px;
            color: #111;
            font-size: 22px;
            line-height: 1.4;
            word-break: break-word;
        }

    .post-meta-top {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }


    /* =====================================================
               CATEGORY
            ===================================================== */

    .category-badge {
        background: #f1f1f1;
        color: #555;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
    }


    /* =====================================================
               POST STATUS
            ===================================================== */

    .post-status {
        padding: 6px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
    }

    .published {
        background: #e8f8ee;
        color: #218838;
    }

    .draft {
        background: #fff4d6;
        color: #946c00;
    }


    /* =====================================================
               POST IMAGE
            ===================================================== */

    .full-post-image {
        width: 100%;
        max-height: 450px;
        overflow: hidden;
        background: #f5f5f5;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .full-post-image img {
            width: 100%;
            max-height: 450px;
            object-fit: contain;
            display: block;
        }


    /* =====================================================
               POST CONTENT
            ===================================================== */

    .full-post-content {
        padding: 25px 22px;
    }

        .full-post-content h4 {
            margin: 0 0 15px;
            font-size: 15px;
            color: #555;
            font-weight: 700;
        }

    .content-text {
        color: #333;
        font-size: 15px;
        line-height: 1.8;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

        .content-text p {
            margin: 0 0 15px;
        }

        .content-text h1,
        .content-text h2,
        .content-text h3,
        .content-text h4,
        .content-text h5,
        .content-text h6 {
            color: #111;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .content-text ul,
        .content-text ol {
            margin: 10px 0 15px 25px;
        }

        .content-text li {
            margin-bottom: 6px;
        }

        .content-text blockquote {
            border-left: 4px solid #111;
            padding-left: 15px;
            margin: 20px 0;
            color: #666;
        }

        .content-text img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            margin: 15px 0;
        }

        .content-text a {
            color: #2563eb;
            text-decoration: underline;
        }

        .content-text table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }

            .content-text table th,
            .content-text table td {
                border: 1px solid #ddd;
                padding: 8px;
            }


    /* =====================================================
               📎 POST ATTACHMENT
            ===================================================== */

    .post-attachment {
        margin: 0 22px 22px;
        padding: 18px;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        background: #fafafa;
    }

    .post-attachment-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .post-attachment-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: #111;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .post-attachment-info {
        min-width: 0;
        flex: 1;
    }

    .post-attachment-title {
        margin: 0;
        font-size: 12px;
        color: #777;
    }

    .post-attachment-name {
        margin: 3px 0 0;
        font-size: 14px;
        font-weight: 600;
        color: #111;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .attachment-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .attachment-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .view-attachment-btn {
        background: #111;
        color: white;
    }

        .view-attachment-btn:hover {
            background: #000;
            color: white;
            transform: translateY(-1px);
        }

    .download-attachment-btn {
        background: #e9f0ff;
        color: #2563eb;
    }

        .download-attachment-btn:hover {
            background: #2563eb;
            color: white;
            transform: translateY(-1px);
        }


    /* =====================================================
               POST FOOTER
            ===================================================== */

    .full-post-footer {
        display: flex;
        align-items: center;
        gap: 30px;
        flex-wrap: wrap;
        padding: 18px 22px;
        background: #fafafa;
        border-top: 1px solid #eee;
    }

    .post-info-item {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #555;
    }

        .post-info-item span {
            font-size: 16px;
        }

        .post-info-item strong {
            color: #111;
            font-size: 14px;
        }

        .post-info-item small {
            color: #888;
            font-size: 12px;
        }


    /* =====================================================
               DELETE BUTTON
            ===================================================== */

    .delete-btn {
        border: none;
        background: #fff0f0;
        color: #dc3545;
        padding: 9px 13px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        transition: 0.2s ease;
        white-space: nowrap;
    }

        .delete-btn:hover {
            background: #dc3545;
            color: white;
        }


    /* =====================================================
               EMPTY POSTS
            ===================================================== */

    .empty-posts {
        text-align: center;
        padding: 55px 20px;
        color: #777;
    }

    .empty-posts-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .empty-posts h3 {
        color: #333;
        margin-bottom: 8px;
    }


    /* =====================================================
               RESPONSIVE
            ===================================================== */

    @@media (max-width: 1200px) {

        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }


    @@media (max-width: 850px) {

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .profile-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-action {
            width: 100%;
        }

            .profile-action form {
                width: 100%;
            }

            .profile-action .status-btn {
                width: 100%;
            }
    }


    @@media (max-width: 650px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .back-btn {
            width: 100%;
            justify-content: center;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .profile-card {
            padding: 18px;
        }

        .profile-left {
            align-items: flex-start;
        }

        .user-avatar {
            width: 60px;
            height: 60px;
            font-size: 23px;
        }

        .user-info h2 {
            font-size: 20px;
        }

        .user-posts-list {
            padding: 12px;
        }

        .full-post-header {
            flex-direction: column;
            padding: 18px;
        }

            .full-post-header form {
                width: 100%;
            }

        .delete-btn {
            width: 100%;
        }

        .full-post-title-area h3 {
            font-size: 19px;
        }

        .full-post-content {
            padding: 20px 16px;
        }

        .post-attachment {
            margin: 0 16px 18px;
            padding: 15px;
        }

        .attachment-actions {
            flex-direction: column;
        }

        .attachment-btn {
            width: 100%;
        }

        .full-post-footer {
            gap: 18px;
            padding: 16px;
        }
    }

</style>


<div class="user-details-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="page-header">

        <div>

            <h1>
                👤 User Details
            </h1>

            <p>
                View user information and manage their posts.
            </p>

        </div>


        <a asp-controller="Users"
           asp-action="Index"
           class="back-btn">

            ← Back to Users

        </a>

    </div>


    <!-- =====================================================
         USER PROFILE
    ====================================================== -->

    <div class="profile-card">

        <div class="profile-content">


            <!-- USER INFORMATION -->

            <div class="profile-left">


                <!-- AVATAR -->

                <div class="user-avatar">

                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                    {
                        <img src="@Model.ProfileImagePath"
                             alt="@Model.Name"
                             onerror="this.style.display='none'; this.parentElement.innerText='@(string.IsNullOrWhiteSpace(Model.Name) ? "U" : Model.Name.Substring(0, 1).ToUpper())';" />
                    }
                    else
                    {
                        @(string.IsNullOrWhiteSpace(Model.Name)
                                            ? "U"
                                            : Model.Name.Substring(0, 1).ToUpper())
                                        }

                </div>


                <!-- NAME / EMAIL / STATUS -->

                <div class="user-info">

                    <h2>
                        @Model.Name
                    </h2>

                    <div class="user-email">
                        @Model.Email
                    </div>


                    @if (Model.IsActive)
                    {
                        <span class="status-badge status-active">
                            ● Active
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-inactive">
                            ● Deactivated
                        </span>
                    }

                </div>

            </div>


            <!-- ACTIVATE / DEACTIVATE -->

            <div class="profile-action">

                @if (isCurrentUser)
                {
                    <span style="color:#777; font-size:13px;">
                        Current Admin
                    </span>
                }
                else
                {
                    <form asp-controller="Users"
                          asp-action="ToggleStatus"
                          method="post"
                          onsubmit="return confirmStatusChange('@Model.Name', @Model.IsActive.ToString().ToLower());">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />


                        @if (Model.IsActive)
                        {
                            <button type="submit"
                                    class="status-btn deactivate-btn">

                                Deactivate User

                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="status-btn activate-btn">

                                Activate User

                            </button>
                        }

                    </form>
                }

            </div>

        </div>

    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="stats-grid">


        <!-- TOTAL POSTS -->

        <div class="stat-card">

            <div class="stat-label">
                Total Posts
            </div>

            <div class="stat-number">
                @Model.TotalPosts
            </div>

        </div>


        <!-- PUBLISHED -->

        <div class="stat-card">

            <div class="stat-label">
                Published
            </div>

            <div class="stat-number">
                @Model.PublishedPosts
            </div>

        </div>


        <!-- DRAFTS -->

        <div class="stat-card">

            <div class="stat-label">
                Drafts
            </div>

            <div class="stat-number">
                @Model.DraftPosts
            </div>

        </div>


        <!-- VIEWS -->

        <div class="stat-card">

            <div class="stat-label">
                Total Views
            </div>

            <div class="stat-number">
                @Model.TotalViews
            </div>

        </div>


        <!-- LIKES -->

        <div class="stat-card">

            <div class="stat-label">
                Total Likes
            </div>

            <div class="stat-number">
                @Model.TotalLikes
            </div>

        </div>

    </div>


    <!-- =====================================================
         USER POSTS
    ====================================================== -->

    <div class="posts-card">


        <!-- POSTS HEADER -->

        <div class="posts-header">

            <h2>
                📝 User Posts
            </h2>

            <p>
                All posts created by
                <strong>@Model.Name</strong>
            </p>

        </div>


        <!-- =================================================
             POSTS
        ================================================== -->
        @if (Model.Posts != null && Model.Posts.Any())
        {
            <div class="user-posts-list">


                @foreach (var post in Model.Posts)
                {
                    <div class="full-post-card">


                        <!-- =================================
                             POST HEADER
                        ================================== -->

                        <div class="full-post-header">


                            <div class="full-post-title-area">

                                <h3>
                                    @post.Title
                                </h3>


                                <div class="post-meta-top">


                                    <!-- CATEGORY -->

                                    <span class="category-badge">
                                        @post.Category
                                    </span>


                                    <!-- STATUS -->
                                    @if (post.IsPublished)
                                    {
                                        <span class="post-status published">
                                            Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="post-status draft">
                                            Draft
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- DELETE POST -->

                            <form asp-controller="Users"
                                  asp-action="DeletePost"
                                  method="post"
                                  onsubmit="return confirmDelete('@post.Title');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@post.Id" />

                                <button type="submit"
                                        class="delete-btn">

                                    🗑 Delete

                                </button>

                            </form>

                        </div>


                        <!-- =================================
                             POST IMAGE
                        ================================== -->
                        @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                        {
                            <div class="full-post-image">

                                <img src="@post.ImagePath"
                                     alt="@post.Title" />

                            </div>
                        }


                        <!-- =================================
                             FULL POST CONTENT
                        ================================== -->

                        <div class="full-post-content">

                            <h4>
                                Post Content
                            </h4>


                            <div class="content-text">

                                @Html.Raw(post.Content)

                            </div>

                        </div>


                        <!-- =================================
                             📎 POST ATTACHMENT
                        ================================== -->
                        @if (!string.IsNullOrWhiteSpace(post.AttachmentPath))
                        {
                            <div class="post-attachment">

                                <div class="post-attachment-header">

                                    <div class="post-attachment-icon">
                                        📎
                                    </div>


                                    <div class="post-attachment-info">

                                        <p class="post-attachment-title">
                                            Attached File
                                        </p>

                                        <p class="post-attachment-name">

                                            @(string.IsNullOrWhiteSpace(post.AttachmentName)
                                                                            ? "Attached File"
                                                                            : post.AttachmentName)

                            </p>

                                    </div>

                                </div>


                                <div class="attachment-actions">


                                    <!-- VIEW FILE -->

                                    <a href="@post.AttachmentPath"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="attachment-btn view-attachment-btn">

                                        👁 View File

                                    </a>


                                    <!-- DOWNLOAD FILE -->

                                    <a href="@post.AttachmentPath"
                                       download="@post.AttachmentName"
                                       class="attachment-btn download-attachment-btn">

                                        ⬇️ Download File

                                    </a>

                                </div>

                            </div>
                                }


                        <!-- =================================
                             POST INFORMATION
                        ================================== -->

                        <div class="full-post-footer">


                            <!-- VIEWS -->

                            <div class="post-info-item">

                                <span>
                                    👁
                                </span>

                                <strong>
                                    @post.Views
                                </strong>

                                <small>
                                    Views
                                </small>

                            </div>


                            <!-- LIKES -->

                            <div class="post-info-item">

                                <span>
                                    ❤️
                                </span>

                                <strong>
                                    @post.Likes
                                </strong>

                                <small>
                                    Likes
                                </small>

                            </div>


                            <!-- CREATED -->

                            <div class="post-info-item">

                                <span>
                                    📅
                                </span>

                                <strong>
                                    @post.CreatedAt.ToString("dd MMM yyyy")
                                </strong>

                                <small>
                                    Created
                                </small>

                            </div>


                            <!-- PUBLISHED -->
                            @if (post.PublishedAt.HasValue)
                            {
                                <div class="post-info-item">

                                    <span>
                                        🚀
                                    </span>

                                    <strong>
                                        @post.PublishedAt.Value.ToString("dd MMM yyyy")
                                    </strong>

                                    <small>
                                        Published
                                    </small>

                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- =============================================
                 NO POSTS
            ============================================== -->

            <div class="empty-posts">

                <div class="empty-posts-icon">
                    📝
                </div>

                <h3>
                    No Posts Found
                </h3>

                <p>
                    This user has not created any posts yet.
                </p>

            </div>
        }

    </div>

</div>


<script>

    // =====================================================
    // DELETE CONFIRMATION
    // =====================================================

    function confirmDelete(title) {

        return confirm(
            "Are you sure you want to delete this post?\n\n" +
            "\"" + title + "\"\n\n" +
            "This action cannot be undone."
        );

    }


    // =====================================================
    // STATUS CONFIRMATION
    // =====================================================

    function confirmStatusChange(name, isActive) {

        if (isActive) {

            return confirm(
                "Are you sure you want to deactivate " +
                name +
                "?"
            );

        }

        return confirm(
            "Are you sure you want to activate " +
            name +
            "?"
        );

    }

</script>