@using Microsoft.AspNetCore.Identity
@using BlogVerse.Models

@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] ??= "Dashboard";

    var currentUser = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        @ViewData["Title"] - BlogVerse
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Dashboard CSS -->

    <link rel="stylesheet"
          href="~/css/dashboard.css" />


    <!-- Font Awesome -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />


    @RenderSection("Styles", required: false)


    <style>

        /* =====================================================
                   ROOT
                ===================================================== */

        :root {
            --dashboard-bg: #f2f2f2;
            --sidebar-bg: rgba(255, 255, 255, .72);
            --glass-bg: rgba(255, 255, 255, .68);
            --glass-border: rgba(0, 0, 0, .08);
            --text-main: #222;
            --text-muted: #777;
            --dark: #222;
            --light: #eeeeee;
        }


        /* =====================================================
                   BODY
                ===================================================== */

        body {
            margin: 0;
            padding: 0;
            background: #f2f2f2;
            color: var(--text-main);
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =====================================================
                   DASHBOARD CONTAINER
                ===================================================== */

        .dashboard-container {
            min-height: 100vh;
            display: flex;
            width: 100%;
            background: radial-gradient( circle at 10% 10%, rgba(255,255,255,.95), transparent 28% ), radial-gradient( circle at 90% 20%, rgba(225,225,225,.75), transparent 30% ), linear-gradient( 135deg, #eeeeee, #e2e2e2 50%, #f7f7f7 );
        }


        /* =====================================================
                   LEFT SIDEBAR
                ===================================================== */

        .sidebar {
            width: 260px;
            min-width: 260px;
            min-height: 100vh;
            padding: 22px 18px;
            position: relative;
            display: flex;
            flex-direction: column;
            background: rgba(255,255,255,.62) !important;
            border-right: 1px solid rgba(0,0,0,.08);
            box-shadow: 8px 0 30px rgba(0,0,0,.05), inset -1px 0 rgba(255,255,255,.7);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 100;
        }


        /* =====================================================
                   SIDEBAR LOGO
                ===================================================== */

        .sidebar-logo-container {
            height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-bottom: 15px;
        }


        .sidebar-logo {
            width: 105px !important;
            height: 105px !important;
            display: block;
            object-fit: contain;
        }


        /* =====================================================
                   NAVIGATION
                ===================================================== */

        .sidebar nav {
            width: 100%;
        }


        .sidebar .nav {
            gap: 4px;
        }


        .sidebar .nav-link {
            min-height: 43px;
            padding: 11px 13px;
            display: flex;
            align-items: center;
            border-radius: 13px;
            color: #444 !important;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: background .2s ease, color .2s ease, transform .2s ease;
        }


            .sidebar .nav-link i {
                width: 20px;
                text-align: center;
                color: #555;
                transition: color .2s ease;
            }


            .sidebar .nav-link:hover {
                background: rgba(0,0,0,.07);
                color: #111 !important;
                transform: translateX(2px);
            }


                .sidebar .nav-link:hover i {
                    color: #111;
                }


            /* =====================================================
                   ACTIVE LINK
                ===================================================== */

            .sidebar .nav-link.active {
                background: #222;
                color: #fff !important;
            }


                .sidebar .nav-link.active i {
                    color: #fff;
                }


        /* =====================================================
                   FOLLOWING
                ===================================================== */

        .following-section {
            margin-top: 12px;
        }


            .following-section hr,
            .sidebar > hr {
                border: 0;
                border-top: 1px solid rgba(0,0,0,.09);
                opacity: 1;
            }


        .following-title {
            margin: 0 0 7px;
            padding-left: 12px;
            color: #555;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .6px;
        }


        .following-empty {
            color: #888 !important;
            font-size: 12px !important;
            font-weight: 500 !important;
        }


        /* =====================================================
                   CREATE POST
                ===================================================== */

        .create-post-button {
            width: 100%;
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 13px;
            background: #222 !important;
            color: #fff !important;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
        }


            .create-post-button:hover {
                background: #000 !important;
                color: #fff !important;
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(0,0,0,.12);
            }


        /* =====================================================
                   LOGOUT
                ===================================================== */

        .logout-button {
            width: 100%;
            min-height: 43px;
            display: flex;
            align-items: center;
            padding: 11px 13px;
            border: 0;
            border-radius: 13px;
            background: transparent;
            color: #555 !important;
            font-family: inherit;
            font-size: 13px;
            font-weight: 600;
            text-align: left;
            cursor: pointer;
            transition: background .2s ease, color .2s ease;
        }


            .logout-button i {
                width: 20px;
                margin-right: 8px;
                text-align: center;
            }


            .logout-button:hover {
                background: rgba(0,0,0,.07);
                color: #222 !important;
            }


        /* =====================================================
                   HAMBURGER
                ===================================================== */

        .hamburger-btn {
            display: none;
            position: fixed;
            top: 15px;
            left: 15px;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0,0,0,.08);
            border-radius: 13px;
            background: rgba(255,255,255,.82);
            color: #222;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            cursor: pointer;
            z-index: 1000;
        }


            .hamburger-btn:hover {
                background: #fff;
            }


        /* =====================================================
                   MAIN CONTENT
                ===================================================== */

        .main-content {
            flex: 1;
            min-width: 0;
            min-height: 100vh;
            background: transparent;
            overflow-x: hidden;
        }


        /* =====================================================
                   RIGHT SIDEBAR
                ===================================================== */

        .right-sidebar {
            width: 285px;
            min-width: 285px;
            min-height: 100vh;
            padding: 22px;
            background: rgba(255,255,255,.58) !important;
            border-left: 1px solid rgba(0,0,0,.07);
            box-shadow: -8px 0 30px rgba(0,0,0,.04);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            color: #333;
        }


        .right-sidebar-banner {
            width: 100%;
            height: 220px;
            margin-bottom: 25px;
            border-radius: 20px;
            background-image: url('/images/png.png');
            background-size: cover;
            background-position: center;
            overflow: hidden;
            box-shadow: 0 10px 28px rgba(0,0,0,.08);
        }


        .right-sidebar-title {
            margin: 0 0 18px;
            color: #222;
            font-size: 17px;
            font-weight: 700;
        }


        .creator-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px;
            margin-bottom: 8px;
            border-radius: 15px;
            background: rgba(255,255,255,.48);
            transition: background .2s ease, transform .2s ease;
        }


            .creator-item:hover {
                background: rgba(255,255,255,.75);
                transform: translateX(-2px);
            }


        .creator-image {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            border-radius: 50%;
            object-fit: cover;
            background: #eee;
        }


        .creator-name {
            margin: 0 0 3px;
            color: #333;
            font-size: 12px;
            font-weight: 700;
        }


        .creator-followers {
            color: #888;
            font-size: 10px;
        }


        /* =====================================================
                   HIDDEN STATES
                ===================================================== */

        .sidebar-hidden {
            display: none !important;
        }


        .right-sidebar-hidden {
            display: none !important;
        }


        .full-width {
            width: 100% !important;
            max-width: 100% !important;
        }


        /* =====================================================
                   RESPONSIVE - TABLET
                ===================================================== */

        @@media (max-width: 1100px) {

            .right-sidebar {
                display: none !important;
            }

            .sidebar {
                width: 235px;
                min-width: 235px;
            }
        }


        /* =====================================================
                   RESPONSIVE - MOBILE
                ===================================================== */

        @@media (max-width: 768px) {

            .dashboard-container {
                display: block;
            }


            .hamburger-btn {
                display: flex;
            }


            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 270px;
                min-width: 270px;
                height: 100vh;
                transform: translateX(-105%);
                transition: transform .25s ease;
                z-index: 999;
            }


                .sidebar.mobile-open {
                    transform: translateX(0);
                }


            .main-content {
                width: 100%;
                min-height: 100vh;
            }
        }


        /* =====================================================
                   SMALL MOBILE
                ===================================================== */

        @@media (max-width: 480px) {

            .sidebar {
                width: 250px;
                min-width: 250px;
            }
        }

    </style>

</head>


<body>


    <div class="dashboard-container">


        <!-- =====================================================
             HAMBURGER
        ====================================================== -->

        <button type="button"
                class="hamburger-btn"
                onclick="toggleSidebar()"
                aria-label="Open navigation">

            <i class="fas fa-bars"></i>

        </button>


        <!-- =====================================================
             LEFT SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- LOGO -->

            <div class="sidebar-logo-container">

                <img src="~/images/modified_logo.png"
                     alt="BlogVerse Logo"
                     class="sidebar-logo" />

            </div>


            <!-- =================================================
                 NAVIGATION
            ================================================== -->

            <nav>

                <ul class="nav flex-column">


                    <!-- BREAKING NEWS -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("BreakingNews", "Dashboard")">

                            <i class="fas fa-bolt me-2"></i>

                            Breaking News

                        </a>

                    </li>


                    <!-- TRENDING -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Trending", "Dashboard")">

                            <i class="fas fa-chart-line me-2"></i>

                            Trending

                        </a>

                    </li>


                    <!-- COMMUNITY -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Community", "Dashboard")">

                            <i class="fas fa-users me-2"></i>

                            Community

                        </a>

                    </li>


                    <!-- CATEGORY -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Category", "Dashboard")">

                            <i class="fas fa-list-ul me-2"></i>

                            Category

                        </a>

                    </li>


                    <!-- HISTORY -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("History", "Dashboard")">

                            <i class="fas fa-history me-2"></i>

                            History

                        </a>

                    </li>


                    <!-- SAVED -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Saved", "Dashboard")">

                            <i class="fas fa-bookmark me-2"></i>

                            Saved

                        </a>

                    </li>


                    <!-- COLLECTIONS -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Collections", "Dashboard")">

                            <i class="fas fa-folder-open me-2"></i>

                            Collections

                        </a>

                    </li>


                    <!-- SETTINGS -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Settings", "Dashboard")">

                            <i class="fas fa-cog me-2"></i>

                            Settings

                        </a>

                    </li>


                    <!-- =================================================
                         ADMIN
                    ================================================== -->
                    @if (User.Identity?.IsAuthenticated == true &&
                                        User.IsInRole("Admin"))
                    {

                        <!-- ADMIN DASHBOARD -->

                        <li class="nav-item">

                            <a class="nav-link"
                               href="@Url.Action("Index", "Admin")">

                                <i class="fas fa-gauge-high me-2"></i>

                                Admin Dashboard

                            </a>

                        </li>


                        <!-- USER MANAGEMENT -->

                        <li class="nav-item">

                            <a class="nav-link"
                               href="@Url.Action("Index", "Users")">

                                <i class="fas fa-user-gear me-2"></i>

                                User Management

                            </a>

                        </li>

                    }


                    <!-- ACCOUNT -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="@Url.Action("Account", "Dashboard")">

                            <i class="fas fa-user-circle me-2"></i>

                            Account

                        </a>

                    </li>

                </ul>

            </nav>


            <!-- =================================================
                 FOLLOWING
            ================================================== -->

            <div class="following-section">

                <hr class="my-3" />

                <div class="following-title">
                    Following
                </div>


                <ul class="nav flex-column">

                    <li class="nav-item">

                        <span class="nav-link following-empty">

                            <i class="fas fa-rss me-2"></i>

                            No followed channels

                        </span>

                    </li>

                </ul>

            </div>


            <!-- =================================================
                 CREATE POST
            ================================================== -->

            <hr class="my-3" />


            <a class="create-post-button"
               href="@Url.Action("Create", "Posts")">

                <i class="fas fa-pen-nib me-2"></i>

                Create a Post

            </a>


            <!-- =================================================
                 HELP + LOGOUT
            ================================================== -->

            <hr class="my-3" />


            <ul class="nav flex-column">


                <!-- HELP -->

                <li class="nav-item">

                    <a class="nav-link"
                       href="#">

                        <i class="fas fa-question-circle me-2"></i>

                        Help Center

                    </a>

                </li>


                <!-- LOGOUT -->

                <li class="nav-item">

                    <form method="post"
                          action="@Url.Action("Logout", "Logout")"
                          style="margin: 0;">

                        <button type="submit"
                                class="logout-button">

                            <i class="fas fa-sign-out-alt"></i>

                            Log Out

                        </button>

                    </form>

                </li>

            </ul>


        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="main-content">

            @RenderBody()

        </main>


        <!-- =====================================================
             RIGHT SIDEBAR
        ====================================================== -->

        <aside class="right-sidebar">


            <div class="right-sidebar-banner">
            </div>


            <h5 class="right-sidebar-title">
                Top Creator
            </h5>


            <!-- CREATOR 1 -->

            <div class="creator-item">

                <img src="~/images/person3.png"
                     alt="Anne Johnson"
                     class="creator-image" />

                <div>

                    <h6 class="creator-name">
                        Anne Johnson
                    </h6>

                    <span class="creator-followers">
                        10.5k Followers
                    </span>

                </div>

            </div>


            <!-- CREATOR 2 -->

            <div class="creator-item">

                <img src="~/images/person2.png"
                     alt="Jane Smith"
                     class="creator-image" />

                <div>

                    <h6 class="creator-name">
                        Jane Smith
                    </h6>

                    <span class="creator-followers">
                        7.8k Followers
                    </span>

                </div>

            </div>


            <!-- CREATOR 3 -->

            <div class="creator-item">

                <img src="~/images/person1.png"
                     alt="Peter Jones"
                     class="creator-image" />

                <div>

                    <h6 class="creator-name">
                        Peter Jones
                    </h6>

                    <span class="creator-followers">
                        5.2k Followers
                    </span>

                </div>

            </div>


        </aside>


    </div>


    <!-- =========================================================
         SCRIPTS
    ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)


    <script>

        function toggleSidebar() {

            const sidebar =
                document.querySelector(".sidebar");

            if (!sidebar) {
                return;
            }


            sidebar.classList.toggle("mobile-open");

        }


        /*
           Close mobile sidebar after clicking a navigation link.
        */

        document.addEventListener("DOMContentLoaded", function () {

            const sidebar =
                document.querySelector(".sidebar");

            if (!sidebar) {
                return;
            }


            const links =
                sidebar.querySelectorAll("a.nav-link");


            links.forEach(function (link) {

                link.addEventListener("click", function () {

                    if (window.innerWidth <= 768) {

                        sidebar.classList.remove(
                            "mobile-open"
                        );

                    }

                });

            });

        });

    </script>


</body>

</html>