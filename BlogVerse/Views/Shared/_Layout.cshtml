<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BlogVerse</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BlogVerse.styles.css"
          asp-append-version="true" />
</head>

<body class="@ViewBag.PageClass">

    <!-- ==============================
         GLASS NAVBAR
         ============================== -->

    <header class="bv-glass-header">

        <nav class="bv-glass-navbar">

            <div class="bv-nav-inner">

                <!-- LOGO -->

                <a class="bv-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="bv-brand-logo">
                        <img src="~/images/icon-quill-spark.png"
                             alt="BlogVerse" />
                    </span>

                    <span class="bv-brand-name">
                        BlogVerse
                    </span>

                </a>


                <!-- MOBILE BUTTON -->

                <button class="bv-mobile-toggle"
                        type="button"
                        aria-label="Open navigation"
                        aria-expanded="false">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>


                <!-- NAVIGATION -->

                <div class="bv-nav-menu">


                    <a class="bv-nav-link"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Login">

                        <span>Login</span>

                    </a>


                    <a class="bv-nav-link"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Register">

                        <span>Register</span>

                    </a>


                    <!-- THEME BUTTON -->

                    <button id="theme-toggle"
                            class="bv-theme-button"
                            type="button"
                            title="Toggle appearance"
                            aria-label="Toggle appearance">

                        <span class="bv-theme-icon">◐</span>

                    </button>

                </div>

            </div>

        </nav>

    </header>


    <!-- ==============================
         PAGE
         ============================== -->

    <main role="main" class="bv-page">

        @RenderBody()

    </main>


    <!-- ==============================
         SCRIPTS
         ============================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"
            integrity="sha512-Yc6vNteNsMSgn4Prd9zKdyYSlKZSn4U0D53+XNPKvE6De4v6e4Z7bHoKrDBafNcAjRHh+Ngf4V1nA83cQQuERA=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"
            integrity="sha512-Wgdf3O44FhR9fyxqXjE/N7rzqMdOocT0VjylWYMB1IgcO4FhNq+UlKqPZSEz1cQmFUpuUKmVUq6l5ql5KXn9tA=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>


    <!-- ==============================
         GLASS NAVIGATION JS
         ============================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const toggle =
                document.getElementById("theme-toggle");

            const mobileToggle =
                document.querySelector(".bv-mobile-toggle");

            const navMenu =
                document.querySelector(".bv-nav-menu");


            /* ==========================
               THEME
               ========================== */

            const savedTheme =
                localStorage.getItem("blogverse-theme");

            if (savedTheme === "dark") {

                document.documentElement
                    .setAttribute("data-theme", "dark");

            }
            else {

                document.documentElement
                    .setAttribute("data-theme", "light");

            }


            toggle?.addEventListener("click", function () {

                const current =
                    document.documentElement
                        .getAttribute("data-theme");

                const next =
                    current === "dark"
                        ? "light"
                        : "dark";

                document.documentElement
                    .setAttribute("data-theme", next);

                localStorage.setItem(
                    "blogverse-theme",
                    next
                );

            });


            /* ==========================
               MOBILE NAV
               ========================== */

            mobileToggle?.addEventListener(
                "click",
                function () {

                    navMenu.classList.toggle(
                        "bv-nav-open"
                    );

                    const opened =
                        navMenu.classList.contains(
                            "bv-nav-open"
                        );

                    mobileToggle
                        .setAttribute(
                            "aria-expanded",
                            opened
                        );

                }
            );


            /* ==========================
               NAV SCROLL EFFECT
               ========================== */

            const header =
                document.querySelector(
                    ".bv-glass-header"
                );


            window.addEventListener(
                "scroll",
                function () {

                    if (window.scrollY > 20) {

                        header.classList.add(
                            "bv-header-scrolled"
                        );

                    }
                    else {

                        header.classList.remove(
                            "bv-header-scrolled"
                        );

                    }

                }
            );

        });

    </script>


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>
</html>